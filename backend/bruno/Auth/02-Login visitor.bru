meta {
  name: Select visitor
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/
  body: none
  auth: none
}

script:pre-request {
  bru.setVar("apiLogin", "visitor");
  req.setHeader("Authorization", "Basic " + Buffer.from("visitor:" + bru.getVar("demoPassword")).toString("base64"));
}

assert {
  res.status: 200
}
