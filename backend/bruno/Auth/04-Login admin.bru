meta {
  name: Select admin
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/
  body: none
  auth: none
}

script:pre-request {
  bru.setVar("apiLogin", "admin");
  req.setHeader("Authorization", "Basic " + Buffer.from("admin:" + bru.getVar("demoPassword")).toString("base64"));
}

assert {
  res.status: 200
}
