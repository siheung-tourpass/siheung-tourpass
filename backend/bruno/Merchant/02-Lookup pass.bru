meta {
  name: Lookup pass
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/merchant/pass-lookups
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "merchantId": "{{merchantId}}",
    "code": "{{passCode}}"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("confirmationToken", res.getBody().confirmationToken);
    bru.deleteVar("issuedBenefitId");
    const benefit = res.getBody().benefits.find(b => b.usable);
    if (benefit) bru.setVar("issuedBenefitId", benefit.issuedBenefitId);
  }
}

assert {
  res.status: 201
}
