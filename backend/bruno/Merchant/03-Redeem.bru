meta {
  name: Redeem
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/merchant/redemptions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "confirmationToken": "{{confirmationToken}}",
    "issuedBenefitId": "{{issuedBenefitId}}"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("redemptionId", res.getBody().id);
  }
}

assert {
  res.status: 201
}

docs {
  Lookup pass 직후 같은 세션에서 실행합니다. 확인 토큰은 5분간 1회 유효하며 혜택 잔여 횟수를 실제 차감합니다.
}
