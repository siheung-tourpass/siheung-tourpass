<%@ page pageEncoding="UTF-8" %>
<div class="destination-grid"><c:forEach var="benefit" items="${benefits}"><article class="destination-card benefit-card"><h2><c:out value="${empty benefit.benefitName ? benefit.name : benefit.benefitName}"/></h2><p class="benefit-value"><strong><c:choose><c:when test="${benefit.benefitType eq 'FREE_ONCE'}">1회 무료</c:when><c:otherwise><c:out value="${benefit.discountWon}"/>원 할인</c:otherwise></c:choose></strong><span>본인 부담 <c:out value="${benefit.payableWon}"/>원 · 이용권당 <c:out value="${benefit.useLimit}"/>회</span></p><c:if test="${view eq 'pass'}"><p class="benefit-state"><c:out value="${benefit.reasonLabel}"/> · 잔여 <c:out value="${benefit.remainingCount}"/>회</p></c:if><p><c:out value="${benefit.description}"/></p><dl>
<dt>가맹점</dt><dd><c:out value="${empty benefit.merchantName ? data.name : benefit.merchantName}"/></dd>
<dt>지역·위치</dt><dd><c:out value="${empty benefit.regionName ? data.regionName : benefit.regionName}"/> · <c:out value="${empty benefit.locationDescription ? data.locationDescription : benefit.locationDescription}"/></dd>
<dt>유형</dt><dd><c:out value="${benefit.benefitType eq 'FREE_ONCE' ? '가상 체험 1회 무료' : '가상 음료 할인'}"/></dd>
<dt>횟수</dt><dd>패스당 <c:out value="${benefit.useLimit}"/>회</dd>
<dt>시연 금액</dt><dd><c:if test="${benefit.benefitType eq 'DISCOUNT'}"><c:out value="${benefit.basePriceWon}"/>원 − <c:out value="${benefit.discountWon}"/>원 할인 = </c:if>본인 부담 <c:out value="${benefit.payableWon}"/>원<c:if test="${benefit.payableWon eq 0}"> · 추가 비용 없음</c:if> · 결제 없음</dd>
<dt>예약</dt><dd>예약 불필요 · <c:out value="${benefit.reservationNote}"/></dd>
<c:if test="${view eq 'pass'}"><dt>잔여 횟수</dt><dd><c:out value="${benefit.remainingCount}"/>회 · <c:out value="${benefit.reasonLabel}"/></dd><dt>사용 시각</dt><dd><c:out value="${empty benefit.usedAtKst ? '아직 사용하지 않음' : benefit.usedAtKst}"/></dd></c:if>
</dl><c:if test="${view eq 'merchant'}"><a href="${root}/products/detail?id=${benefit.productId}">이 혜택이 포함된 이용권 보기 →</a></c:if></article></c:forEach></div>
