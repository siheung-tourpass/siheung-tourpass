<div class="card-placeholder" aria-hidden="true"><svg viewBox="0 0 96 96"><c:choose><c:when test="${card.category eq '카페'}"><path d="M22 36h44v24a18 18 0 0 1-18 18H40a18 18 0 0 1-18-18ZM66 40h6a10 10 0 0 1 0 20h-6M16 84h62M34 14v10M48 10v14M62 14v10"/></c:when><c:when test="${card.kind eq 'dining'}"><circle cx="48" cy="48" r="26"/><path d="M10 16v18c0 10 12 10 12 0V16M16 16v64M86 80V16c-12 8-12 32 0 32"/></c:when><c:when test="${card.kind eq 'event'}"><rect x="16" y="22" width="64" height="60" rx="10"/><path d="M32 14v16M64 14v16M16 42h64m-47 16 10 10 20-20"/></c:when><c:otherwise><path d="m8 70 24-38 22 28 14-18 20 28M8 80h80"/><circle cx="68" cy="20" r="8"/></c:otherwise></c:choose></svg></div>
