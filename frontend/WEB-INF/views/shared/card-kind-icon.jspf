<%@ page pageEncoding="UTF-8" %>
<svg viewBox="0 0 24 24" aria-hidden="true"><c:choose>
<c:when test="${card.kind eq 'event'}"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M7 3v4M17 3v4M3 11h18M8 16h3"/></c:when>
<c:when test="${card.kind eq 'dining'}"><path d="M4 3v6c0 3 6 3 6 0V3M7 3v18M20 21V3c-5 2-5 10 0 10"/></c:when>
<c:otherwise><path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></c:otherwise>
</c:choose></svg>
