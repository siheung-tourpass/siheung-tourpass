<%@ page pageEncoding="UTF-8" %>
<c:if test="${not empty badgeBenefits}"><c:set var="badge" value="${badgeBenefits[0]}"/><p class="benefit-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18v4a2 2 0 0 0 0 4v4H3v-4a2 2 0 0 0 0-4V6Zm12 2v2m0 2v2m0 2v1"/></svg><span>투어패스 · <c:out value="${empty badge.benefitName ? badge.name : badge.benefitName}"/><c:if test="${not empty badge.reason}"> · ${badge.remainingCount eq 0 ? '사용 완료' : badge.reason eq 'AVAILABLE' ? '사용 가능' : badge.reason eq 'PASS_NOT_STARTED' ? '사용 예정' : '사용 불가'}</c:if></span></p></c:if>
