<%@ page pageEncoding="UTF-8" %>
<h1>프로필</h1>
<c:choose><c:when test="${not empty user}"><section class="panel"><h2><c:out value="${user.displayName}"/>님</h2><p>${user.role eq 'VISITOR' ? '방문객' : user.role eq 'STAFF' ? '가맹점 담당자' : '관리자'} 계정</p></section></c:when><c:otherwise><p>로그인하면 임시 저장한 패스와 여행 기록을 이어갈 수 있습니다.</p><a class="button" href="${root}/login">로그인</a></c:otherwise></c:choose>
<section class="panel"><h2>화면 설정</h2><label class="place-pick"><input id="reduce-motion" type="checkbox">카드 움직임 줄이기</label><p class="form-hint">이 브라우저에 저장됩니다. 기기의 모션 감소 설정도 적용합니다.</p><p id="preference-status" role="status"></p></section>
<c:if test="${user.role eq 'VISITOR'}"><section class="panel"><h2>혜택 관리</h2><p><a href="${root}/passes">시연 혜택 발급·이용권 관리</a></p><p><a href="${root}/feedback/history">가맹점 혜택 사용 기록·평가</a></p></section></c:if>
<c:if test="${not empty user}"><form method="post" action="${root}/logout"><input type="hidden" name="csrf" value="${fn:escapeXml(csrf)}"><button class="secondary">로그아웃</button></form></c:if>
