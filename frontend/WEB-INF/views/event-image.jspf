<%@ page pageEncoding="UTF-8" %>
<c:choose><c:when test="${not empty event.image}"><figure class="place-photo"><c:if test="${view ne 'journey-builder'}"><img src="${root}${fn:escapeXml(event.image.path)}" alt="${fn:escapeXml(event.image.alt)}" loading="lazy" width="500" height="300"></c:if><figcaption><c:out value="${event.image.attribution}"/> <a href="${fn:escapeXml(event.image.sourceUrl)}" target="_blank" rel="noopener">사진 출처</a> · <a href="${fn:escapeXml(event.image.licenseUrl)}" target="_blank" rel="noopener">이용 조건</a><c:if test="${view eq 'journey-builder'}"><p>화면 표시: 원본 비율 유지·틴트 적용</p></c:if></figcaption></figure></c:when><c:otherwise><c:if test="${view ne 'journey-builder'}"><p class="photo-pending">행사 이미지 준비 중</p></c:if></c:otherwise></c:choose>
