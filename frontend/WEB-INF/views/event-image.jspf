<%@ page pageEncoding="UTF-8" %>
<c:choose><c:when test="${not empty event.image}"><figure class="place-photo"><c:if test="${view ne 'journey-builder'}"><img src="${root}${fn:escapeXml(event.image.path)}" alt="${fn:escapeXml(event.image.alt)}" loading="lazy" width="${event.image.width}" height="${event.image.height}"></c:if><figcaption><c:out value="${event.image.attribution}"/> <c:set var="creditImage" value="${event.image}"/><c:set var="creditSourceLabel" value="이미지 출처"/><%@ include file="image-credit-links.jspf" %><c:if test="${view eq 'journey-builder'}"><p>화면 표시: 원본 비율 유지·전체 이미지 표시</p></c:if></figcaption></figure></c:when><c:otherwise><c:if test="${view ne 'journey-builder'}"><p class="photo-pending">행사 이미지 준비 중</p></c:if></c:otherwise></c:choose>
