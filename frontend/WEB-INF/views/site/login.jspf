<%@ page pageEncoding="UTF-8" %>
<section class="panel login-panel">
  <img class="login-character" src="${root}/assets/images/siheung_character.png" width="640" height="640" alt="">
  <h1>로그인</h1>
  <p>계정으로 로그인해 이어서 이용하세요.</p>
  <c:if test="${not empty message}"><p class="error" role="alert"><c:out value="${message}"/></p></c:if>
  <form method="post" action="${root}/login">
    <%@ include file="/WEB-INF/views/shared/csrf.jspf" %>
    <label>아이디<input name="loginId" maxlength="100" autocomplete="username" required></label>
    <label>비밀번호<input type="password" name="password" maxlength="500" autocomplete="current-password" required></label>
    <button type="submit">로그인</button>
  </form>
  <div class="login-divider"><span>또는</span></div>
  <form method="post" action="${root}/login/kakao">
    <%@ include file="/WEB-INF/views/shared/csrf.jspf" %>
    <button type="submit" class="kakao-login" ${kakaoEnabled ? '' : 'disabled'}>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3C6.48 3 2 6.36 2 10.5c0 2.66 1.85 5 4.64 6.33l-.93 3.46a.4.4 0 0 0 .6.44l4.08-2.77c.53.06 1.07.09 1.61.09 5.52 0 10-3.36 10-7.55S17.52 3 12 3Z"/></svg>
      <span>${kakaoEnabled ? '카카오톡으로 로그인' : '카카오 로그인 준비 중'}</span>
    </button>
  </form>
  <c:if test="${not kakaoEnabled}"><p class="login-notice">카카오 로그인은 준비 중이에요. 아이디와 비밀번호로 로그인해 주세요.</p></c:if>
  <p class="login-alternative">먼저 둘러보고 싶다면 <a href="${root}/explore">여행 카드 둘러보기 →</a></p>
</section>
