<%@ page pageEncoding="UTF-8" %>
<c:set var="eventDeck" value="${view eq 'journey-builder'}"/>
<article class="event-card ${eventDeck ? 'builder-card' : 'destination-card'} ${eventDeck and not empty event.image ? 'has-background' : ''}" data-card-kind="event" data-card-key="event:${fn:escapeXml(event.code)}" data-saved-only="${event.savedOnly}" data-start-date="${fn:escapeXml(event.start_date)}" data-end-date="${fn:escapeXml(event.end_date)}">
<c:choose><c:when test="${eventDeck}">
<div class="card-front"><c:if test="${not empty event.image}"><img class="card-background" src="${root}${fn:escapeXml(event.image.path)}" alt="${fn:escapeXml(event.image.alt)}" loading="lazy" width="${event.image.width}" height="${event.image.height}" draggable="false"></c:if><p class="card-kind"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M7 3v4M17 3v4M3 11h18M8 16h3"/></svg>행사</p><c:if test="${empty event.image}"><div class="card-placeholder" aria-hidden="true"><svg viewBox="0 0 96 96"><rect x="16" y="22" width="64" height="60" rx="10"/><path d="M32 14v16M64 14v16M16 42h64m-47 16 10 10 20-20"/></svg></div></c:if><div class="card-overview"><%@ include file="event-overview.jspf" %></div>
<c:set var="cardDetails" value="일정·이용 정보"/><%@ include file="card-actions.jspf" %></div>
</c:when><c:otherwise>
<%@ include file="event-image.jspf" %><p class="result-meta"><strong><c:out value="${event.scheduleLabel}"/></strong> · <c:out value="${event.reviewStatusLabel}"/></p>
<%@ include file="event-overview.jspf" %><p class="card-description"><c:out value="${event.description}"/></p>
</c:otherwise></c:choose>
<details class="card-details ${eventDeck ? 'card-back' : ''}"><summary>일정·이용 정보</summary><div class="card-detail-content">
<c:if test="${eventDeck}"><h4><c:out value="${event.name}"/></h4><p class="result-meta"><strong><c:out value="${event.scheduleLabel}"/></strong> · <c:out value="${event.reviewStatusLabel}"/></p><p><c:out value="${event.description}"/></p><%@ include file="event-image.jspf" %></c:if>
<dl><dt>운영 시간</dt><dd><c:out value="${event.daily_hours}"/></dd><dt>주소</dt><dd><c:out value="${event.address}"/></dd><dt>비용</dt><dd><c:out value="${event.admission_fee}"/></dd><dt>예약 조건</dt><dd><c:out value="${event.reservation_note}"/></dd></dl>
<c:if test="${not empty event.notes}"><details><summary>안내 확인 사항</summary><ul><c:forEach var="note" items="${event.notes}"><li><c:out value="${note}"/></li></c:forEach></ul></details></c:if>
<p class="event-sources"><c:forEach var="source" items="${event.sources}" varStatus="loop"><c:if test="${not loop.first}"> · </c:if><a href="${fn:escapeXml(source.url)}" target="_blank" rel="noopener"><c:out value="${source.publisher}"/> 공식 안내 · 새 탭</a></c:forEach></p>
<p class="result-meta">자료 확인 <c:out value="${event.checked_on}"/> · 실제 개최·참여 가능 여부 미확인</p>
<p class="form-hint">여행에 담아도 행사 예약·접수가 되지 않습니다.</p></div><c:if test="${eventDeck}"><%@ include file="card-close.jspf" %></c:if></details>
</article>
