<%@ page pageEncoding="UTF-8" %>
<h1>서비스 관리</h1><p>상품과 장소 정보를 관리하고, 추천에 쓰일 자료를 검토하세요.</p><nav aria-label="관리 메뉴">
<a href="${root}/admin/catalog?collection=products">상품</a><a href="${root}/admin/catalog?collection=merchants">가맹점</a><a href="${root}/admin/catalog?collection=benefits">혜택</a><a href="${root}/admin/passes">패스·취소</a>
<a href="${root}/admin/ontology?collection=places">장소·검토</a><a href="${root}/admin/ontology?collection=regions">지역</a><a href="${root}/admin/ontology?collection=themes">테마</a><a href="${root}/admin/ontology?collection=companion-types">동반 유형</a><a href="${root}/admin/relations">관계·검토</a></nav>
<c:if test="${view eq 'editor'}"><c:set var="editorPath" value="${semantic ? '/admin/ontology' : '/admin/catalog'}"/><h2>목록</h2><c:forEach var="item" items="${data}"><p><a href="${root}${editorPath}?collection=${collection}&amp;id=${item.id}"><c:out value="${item.name}"/></a> · ID ${item.id} · <c:out value="${item.active ? '활성' : '비활성'}"/> <c:out value="${item.reviewStatus}"/></p></c:forEach>
<a href="${root}${editorPath}?collection=${collection}">새 자료 등록</a><h2><c:out value="${empty current ? '새 자료' : current.name}"/></h2>
<form method="post" action="${root}${editorPath}/save"><input type="hidden" name="csrf" value="${fn:escapeXml(csrf)}"><input type="hidden" name="collection" value="${collection}"><input type="hidden" name="id" value="${current.id}">
<c:forEach var="field" items="${fields}"><label><c:choose>
<c:when test="${field eq 'code'}">고유 코드</c:when><c:when test="${field eq 'name'}">이름</c:when><c:when test="${field eq 'description'}">소개·내용</c:when><c:when test="${field eq 'locationDescription'}">위치 설명 · 가맹점에는 ‘가상’ 포함</c:when><c:when test="${field eq 'reservationNote'}">예약 조건</c:when><c:when test="${field eq 'benefitType'}">혜택 유형</c:when><c:when test="${field eq 'basePriceWon'}">기준 금액 · 무료 혜택이면 비움</c:when><c:when test="${field eq 'discountWon'}">할인 금액 · 무료 혜택이면 비움</c:when><c:when test="${field eq 'payableWon'}">본인 부담 금액</c:when><c:when test="${field eq 'placeId'}">연결 장소</c:when><c:when test="${field eq 'regionId'}">지역</c:when><c:when test="${field eq 'productId'}">상품</c:when><c:when test="${field eq 'merchantId'}">가맹점</c:when></c:choose>
<c:choose><c:when test="${field eq 'description' or field eq 'locationDescription' or field eq 'reservationNote'}"><textarea name="${field}" maxlength="${field eq 'description' ? (collection eq 'places' ? 2000 : 1000) : 500}" required><c:out value="${current[field]}"/></textarea></c:when>
<c:when test="${field eq 'benefitType'}"><select name="benefitType"><option value="FREE_ONCE" ${current.benefitType eq 'FREE_ONCE' ? 'selected' : ''}>1회 무료</option><option value="DISCOUNT" ${current.benefitType eq 'DISCOUNT' ? 'selected' : ''}>할인</option></select></c:when>
<c:when test="${fn:endsWith(field,'Id')}"><c:set var="choices" value="${field eq 'placeId' ? options.places : field eq 'regionId' ? options.regions : field eq 'productId' ? options.products : options.merchants}"/><select name="${field}" required><c:forEach var="item" items="${choices}"><option value="${item.id}" ${current[field] eq item.id ? 'selected' : ''}><c:out value="${item.name}"/> (ID ${item.id})</option></c:forEach></select></c:when>
<c:otherwise><input name="${field}" type="${fn:endsWith(field,'Won') ? 'number' : 'text'}" value="${fn:escapeXml(current[field])}" min="0" max="2147483647" maxlength="${field eq 'code' ? 64 : 100}" ${field eq 'basePriceWon' or field eq 'discountWon' ? '' : 'required'}></c:otherwise></c:choose></label></c:forEach>
<c:if test="${not empty current}"><label>상태<select name="active"><option value="true" ${current.active ? 'selected' : ''}>활성</option><option value="false" ${current.active ? '' : 'selected'}>비활성</option></select></label></c:if>
<c:if test="${collection eq 'places'}"><%@ include file="annotation.jspf" %><fieldset><legend>추가 출처 · 실제 자료만</legend><c:forEach var="source" items="${current.sources}"><label>URL<input type="url" name="extraSourceUrl" value="${fn:escapeXml(source.sourceUrl)}"></label><label>확인일<input type="date" name="extraCheckedOn" value="${fn:escapeXml(source.checkedOn)}"></label><label>근거<textarea name="extraEvidenceNote"><c:out value="${source.evidenceNote}"/></textarea></label></c:forEach><label>추가 URL<input type="url" name="extraSourceUrl"></label><label>확인일<input type="date" name="extraCheckedOn"></label><label>근거<textarea name="extraEvidenceNote" maxlength="1000"></textarea></label></fieldset></c:if><button>저장</button></form>
<c:if test="${not empty current}"><p>저장된 상태: <c:out value="${current.reviewStatusLabel}"/> · <c:out value="${current.materialKind eq 'REAL' ? '실제 자료' : '시연 자료'}"/></p><form method="post" action="${root}${editorPath}/deactivate"><input type="hidden" name="csrf" value="${fn:escapeXml(csrf)}"><input type="hidden" name="collection" value="${collection}"><input type="hidden" name="id" value="${current.id}"><button>비활성화</button></form>
<c:if test="${collection eq 'places'}"><form method="post" action="${root}/admin/ontology/review"><input type="hidden" name="csrf" value="${fn:escapeXml(csrf)}"><input type="hidden" name="collection" value="places"><input type="hidden" name="id" value="${current.id}"><label>자료 검토<select name="status"><option value="APPROVED">승인</option><option value="REJECTED">반려</option></select></label><button>검토 결과 저장</button></form></c:if></c:if></c:if>
<c:if test="${view eq 'relations'}"><h2>의미 관계</h2><nav><a href="${root}/admin/relations?type=has-theme">장소 → 테마</a><a href="${root}/admin/relations?type=suitable-for">장소 → 동반 유형</a><a href="${root}/admin/relations?type=sub-theme-of">하위 → 상위 테마</a></nav>
<c:forEach var="item" items="${data}"><p><a href="${root}/admin/relations?type=${relationType}&amp;fromId=${item[fromKey]}&amp;toId=${item[toKey]}">ID ${item[fromKey]} → ${item[toKey]}</a> · <c:out value="${item.reviewStatus}"/> · <c:out value="${item.evidenceNote}"/></p></c:forEach><a href="${root}/admin/relations?type=${relationType}">새 관계 등록</a>
<form method="post" action="${root}/admin/relations/save"><input type="hidden" name="csrf" value="${fn:escapeXml(csrf)}"><input type="hidden" name="type" value="${relationType}"><input type="hidden" name="operation" value="${empty current ? 'create' : 'update'}">
<label>출발 개념<select name="fromId"><c:forEach var="item" items="${relationType eq 'sub-theme-of' ? options.themes : options.places}"><c:if test="${empty current or item.id eq current[fromKey]}"><option value="${item.id}"><c:out value="${item.name}"/> (ID ${item.id})</option></c:if></c:forEach></select></label>
<label>도착 개념<select name="toId"><c:forEach var="item" items="${relationType eq 'suitable-for' ? options['companion-types'] : options.themes}"><c:if test="${empty current or item.id eq current[toKey]}"><option value="${item.id}"><c:out value="${item.name}"/> (ID ${item.id})</option></c:if></c:forEach></select></label><%@ include file="annotation.jspf" %><button>관계 저장</button></form>
<c:if test="${not empty current}"><p>검토 상태: <c:out value="${current.reviewStatusLabel}"/> · <c:out value="${current.active ? '활성' : '비활성'}"/></p><form method="post" action="${root}/admin/relations/review"><input type="hidden" name="csrf" value="${fn:escapeXml(csrf)}"><input type="hidden" name="type" value="${relationType}"><input type="hidden" name="fromId" value="${current[fromKey]}"><input type="hidden" name="toId" value="${current[toKey]}"><label>검토 결과<select name="status"><option value="APPROVED">승인</option><option value="REJECTED">반려</option></select></label><button>관계 검토 저장</button></form><form method="post" action="${root}/admin/relations/deactivate"><input type="hidden" name="csrf" value="${fn:escapeXml(csrf)}"><input type="hidden" name="type" value="${relationType}"><input type="hidden" name="fromId" value="${current[fromKey]}"><input type="hidden" name="toId" value="${current[toKey]}"><button>관계 비활성화</button></form></c:if></c:if>
