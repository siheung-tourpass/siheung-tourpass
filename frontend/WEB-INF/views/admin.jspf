<%@ page pageEncoding="UTF-8" %>
<div class="admin-heading"><div><h1><c:out value="${view eq 'editor' ? (semantic ? collectionLabel : '혜택 관리') : view eq 'relations' ? '관계·검토' : view eq 'goods' ? '카드 출력' : '관광 관리'}"/></h1><p><c:out value="${view eq 'goods' ? '선택한 카드의 문구와 수량을 설정하세요.' : view eq 'relations' ? '추천에 쓰이는 연결 근거를 확인하세요.' : view eq 'editor' ? '카드를 선택해 내용을 확인하고 수정하세요.' : '여행 카드를 살펴보고 정보를 관리하세요.'}"/></p></div><c:if test="${view eq 'admin'}"><a class="button secondary" href="${root}/admin/ontology?collection=places&amp;reviewStatus=DRAFT&amp;active=true">검토 대기 ${data.pending}</a></c:if></div>
<%@ include file="admin-nav.jspf" %>
<c:if test="${view eq 'admin'}"><%@ include file="admin-card-browser.jspf" %></c:if>
<c:if test="${view eq 'goods'}"><%@ include file="goods.jspf" %></c:if>
<c:if test="${view eq 'editor'}"><c:set var="editorPath" value="${semantic ? '/admin/ontology' : '/admin/catalog'}"/><c:if test="${param.saved eq '1'}"><p class="admin-success" role="status">저장했습니다. 아래에서 현재 상태를 확인하세요.</p></c:if>
<div class="admin-workbench ${empty current and param.create ne '1' ? 'admin-browsing' : ''}"><section class="admin-list panel" id="admin-list"><div class="admin-list-heading"><h2><c:out value="${collectionLabel}"/> <small>${fn:length(data)}건</small></h2><a class="button secondary" href="${root}${editorPath}?collection=${collection}&amp;create=1#admin-edit">새 자료 등록</a></div>
<form method="get" action="${root}${editorPath}" class="admin-filters"><input type="hidden" name="collection" value="${collection}"><label>이름·코드 검색<input name="q" type="search" maxlength="100" value="${fn:escapeXml(param.q)}"></label><label>활성 상태<select name="active"><option value="">전체</option><option value="true" ${param.active eq 'true' ? 'selected' : ''}>활성</option><option value="false" ${param.active eq 'false' ? 'selected' : ''}>비활성</option></select></label><c:if test="${collection eq 'places'}"><label>검토 상태<select name="reviewStatus"><option value="">전체</option><option value="DRAFT" ${param.reviewStatus eq 'DRAFT' ? 'selected' : ''}>검토 대기</option><option value="APPROVED" ${param.reviewStatus eq 'APPROVED' ? 'selected' : ''}>승인</option><option value="REJECTED" ${param.reviewStatus eq 'REJECTED' ? 'selected' : ''}>반려</option></select></label></c:if><div class="actions"><button>검색</button><a href="${root}${editorPath}?collection=${collection}">초기화</a></div></form>
<div class="admin-records admin-catalog-records ${collection eq 'products' ? 'admin-product-records' : ''}"><c:forEach var="item" items="${data}"><c:url var="recordUrl" value="${editorPath}"><c:param name="collection" value="${collection}"/><c:param name="id" value="${item.id}"/><c:param name="q" value="${param.q}"/><c:param name="active" value="${param.active}"/><c:param name="reviewStatus" value="${param.reviewStatus}"/></c:url><a class="admin-record" href="${fn:escapeXml(recordUrl)}#admin-edit" ${current.id eq item.id ? 'aria-current=true' : ''}><c:if test="${collection eq 'places'}"><div class="admin-record-photo"><c:choose><c:when test="${not empty item.image}"><img src="${root}${fn:escapeXml(item.image.path)}" alt="${fn:escapeXml(item.image.alt)}" loading="lazy"></c:when><c:otherwise><span>관광지</span></c:otherwise></c:choose></div></c:if><strong><c:out value="${item.name}"/></strong><span class="admin-record-code"><c:out value="${item.code}"/> · <c:out value="${item.active ? '활성' : '비활성'}"/></span><c:if test="${not empty item.reviewStatus}"><span class="admin-status"><c:out value="${item.reviewStatusLabel}"/></span></c:if><c:if test="${not semantic}"><span class="admin-record-description"><c:out value="${collection eq 'merchants' ? item.locationDescription : fn:replace(item.description, '·실제 사용 불가', '')}"/></span><c:if test="${collection eq 'benefits'}"><span><c:out value="${merchantNames[item.merchantId]}"/> · 본인 부담 ${item.payableWon}원</span></c:if><c:forEach var="benefit" items="${catalogBenefits[item.id]}"><span class="admin-linked-benefit"><c:out value="${merchantNames[benefit.merchantId]}"/> · <c:out value="${benefit.name}"/> · ${benefit.active ? '활성' : '비활성'}</span></c:forEach></c:if><span class="admin-record-action">${current.id eq item.id ? '선택됨' : '내용 편집 →'}</span></a></c:forEach><c:if test="${empty data}"><p>검색 결과가 없습니다. 검색어나 필터를 변경해 주세요.</p></c:if></div>
</section>
<c:if test="${not empty current or param.create eq '1'}"><section class="admin-edit panel" id="admin-edit" tabindex="-1"><div class="admin-edit-heading"><p class="admin-context">${empty current ? '새 자료' : '선택한 자료 편집'}</p><a href="#admin-list">목록으로 ↑</a></div><h2><c:out value="${empty current ? '새 자료 등록' : current.name}"/></h2><c:if test="${not empty current}"><p>고유 코드: <c:out value="${current.code}"/> · ID ${current.id}</p></c:if>
<form method="post" action="${root}${editorPath}/save"><%@ include file="csrf.jspf" %><input type="hidden" name="collection" value="${collection}"><input type="hidden" name="id" value="${current.id}">
<p class="admin-help">필수 입력 항목은 각 항목에 표시됩니다.</p><div class="admin-fields"><c:forEach var="field" items="${fields}"><label class="${field eq 'description' or field eq 'locationDescription' or field eq 'reservationNote' ? 'admin-field-wide' : ''}"><span><c:out value="${fieldLabels[field]}"/><c:if test="${field ne 'basePriceWon' and field ne 'discountWon'}"><small class="admin-required">필수</small></c:if></span>
<c:choose><c:when test="${field eq 'description' or field eq 'locationDescription' or field eq 'reservationNote'}"><textarea name="${field}" maxlength="${field eq 'description' ? (collection eq 'places' ? 2000 : 1000) : 500}" required><c:out value="${current[field]}"/></textarea></c:when>
<c:when test="${field eq 'benefitType'}"><select name="benefitType"><option value="FREE_ONCE" ${current.benefitType eq 'FREE_ONCE' ? 'selected' : ''}>1회 무료</option><option value="DISCOUNT" ${current.benefitType eq 'DISCOUNT' ? 'selected' : ''}>할인</option></select></c:when>
<c:when test="${fn:endsWith(field,'Id')}"><select name="${field}" required><c:forEach var="item" items="${options[field]}"><option value="${item.id}" ${current[field] eq item.id ? 'selected' : ''}><c:out value="${item.name}"/> (ID ${item.id})</option></c:forEach></select></c:when>
<c:otherwise><input name="${field}" type="${fn:endsWith(field,'Won') ? 'number' : 'text'}" value="${fn:escapeXml(current[field])}" min="0" max="2147483647" maxlength="${field eq 'code' ? 64 : 100}" ${field eq 'basePriceWon' or field eq 'discountWon' ? '' : 'required'}></c:otherwise></c:choose></label></c:forEach></div>
<c:if test="${not empty current}"><label>상태<select name="active"><option value="true" ${current.active ? 'selected' : ''}>활성</option><option value="false" ${current.active ? '' : 'selected'}>비활성</option></select></label></c:if>
<c:if test="${collection eq 'places'}"><%@ include file="annotation.jspf" %><fieldset><legend>추가 출처 · 실제 자료만</legend><c:forEach var="source" items="${current.sources}"><%@ include file="source-fields.jspf" %></c:forEach><c:remove var="source"/><%@ include file="source-fields.jspf" %></fieldset></c:if><div class="admin-save-bar"><span>내용을 확인한 뒤 저장하세요.</span><button>저장</button></div></form>
<c:if test="${not empty current}"><p class="admin-saved-state">현재 상태: <c:out value="${current.active ? '활성' : '비활성'}"/><c:if test="${collection eq 'places'}"> ·  <c:out value="${current.reviewStatusLabel}"/> · <c:out value="${current.materialKind eq 'REAL' ? '실제 자료' : '시연 자료'}"/></c:if></p><details class="admin-danger"><summary>자료 비활성화</summary><p>공개·신규 이용에서 제외합니다. 기존 이력은 보존됩니다.</p><form method="post" action="${root}${editorPath}/deactivate"><%@ include file="csrf.jspf" %><input type="hidden" name="collection" value="${collection}"><input type="hidden" name="id" value="${current.id}"><button>비활성화</button></form></details>
<c:if test="${collection eq 'places'}"><form class="admin-review" method="post" action="${root}/admin/ontology/review"><h3>자료 검토</h3><p>출처와 확인일을 확인한 뒤 승인 또는 반려하세요.</p><%@ include file="csrf.jspf" %><input type="hidden" name="collection" value="places"><input type="hidden" name="id" value="${current.id}"><label>자료 검토<select name="status"><option value="APPROVED">승인</option><option value="REJECTED">반려</option></select></label><button>검토 결과 저장</button></form></c:if></c:if></section></c:if></div></c:if>
<c:if test="${view eq 'relations'}"><h2>의미 관계</h2><nav class="admin-nav" aria-label="관계 유형"><a href="${root}/admin/relations?type=has-theme" ${relationType eq 'has-theme' ? 'aria-current=page' : ''}>장소 → 테마</a><a href="${root}/admin/relations?type=suitable-for" ${relationType eq 'suitable-for' ? 'aria-current=page' : ''}>장소 → 동반 유형</a><a href="${root}/admin/relations?type=sub-theme-of" ${relationType eq 'sub-theme-of' ? 'aria-current=page' : ''}>하위 → 상위 테마</a></nav>
<div class="admin-workbench"><section class="panel admin-list"><h2>등록 관계</h2><div class="admin-records"><c:forEach var="item" items="${data}"><a class="admin-record" href="${root}/admin/relations?type=${relationType}&amp;fromId=${item[fromKey]}&amp;toId=${item[toKey]}#relation-edit" ${current[fromKey] eq item[fromKey] and current[toKey] eq item[toKey] ? 'aria-current=true' : ''}><strong><c:out value="${item.fromName}"/> → <c:out value="${item.toName}"/></strong><span><c:out value="${item.reviewStatusLabel}"/> · <c:out value="${item.active ? '활성' : '비활성'}"/></span></a></c:forEach><c:if test="${empty data}"><p>등록된 관계가 없습니다.</p></c:if></div><a class="button secondary" href="${root}/admin/relations?type=${relationType}">새 관계 등록</a></section><section class="panel admin-edit" id="relation-edit" tabindex="-1"><h2>${empty current ? '새 관계 등록' : '관계 편집'}</h2>
<form method="post" action="${root}/admin/relations/save"><%@ include file="csrf.jspf" %><input type="hidden" name="type" value="${relationType}"><input type="hidden" name="operation" value="${empty current ? 'create' : 'update'}">
<label>출발 개념<select name="fromId"><c:forEach var="item" items="${relationType eq 'sub-theme-of' ? options.themes : options.places}"><c:if test="${empty current or item.id eq current[fromKey]}"><option value="${item.id}"><c:out value="${item.name}"/> (ID ${item.id})</option></c:if></c:forEach></select></label>
<label>도착 개념<select name="toId"><c:forEach var="item" items="${relationType eq 'suitable-for' ? options['companion-types'] : options.themes}"><c:if test="${empty current or item.id eq current[toKey]}"><option value="${item.id}"><c:out value="${item.name}"/> (ID ${item.id})</option></c:if></c:forEach></select></label><%@ include file="annotation.jspf" %><button>관계 저장</button></form>
<c:if test="${not empty current}"><p>검토 상태: <c:out value="${current.reviewStatusLabel}"/> · <c:out value="${current.active ? '활성' : '비활성'}"/></p><form method="post" action="${root}/admin/relations/review"><%@ include file="csrf.jspf" %><input type="hidden" name="type" value="${relationType}"><input type="hidden" name="fromId" value="${current[fromKey]}"><input type="hidden" name="toId" value="${current[toKey]}"><label>검토 결과<select name="status"><option value="APPROVED">승인</option><option value="REJECTED">반려</option></select></label><button>관계 검토 저장</button></form><details class="admin-danger"><summary>관계 비활성화</summary><p>추천에서 이 관계를 제외합니다. 기존 이력은 보존됩니다.</p><form method="post" action="${root}/admin/relations/deactivate"><%@ include file="csrf.jspf" %><input type="hidden" name="type" value="${relationType}"><input type="hidden" name="fromId" value="${current[fromKey]}"><input type="hidden" name="toId" value="${current[toKey]}"><button>관계 비활성화</button></form></details></c:if></section></div></c:if>
