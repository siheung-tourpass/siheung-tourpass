<%@ page pageEncoding="UTF-8" %>
<div class="pass-card-action"><c:if test="${empty user or user.role eq 'VISITOR'}"><c:choose><c:when test="${issueProduct.journeyAvailable}"><a class="button secondary" href="${root}${empty user ? '/login' : '/journeys/new?productId='}${empty user ? '' : issueProduct.id}">${empty user ? '로그인 후 이 상품으로 여행 시작' : '이 상품으로 여행 시작'}</a></c:when><c:otherwise><button disabled>상품으로 여행 시작 불가</button><p class="form-hint">혜택 장소 자료 준비 중</p></c:otherwise></c:choose></c:if></div>
