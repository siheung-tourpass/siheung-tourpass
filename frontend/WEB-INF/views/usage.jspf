<%@ page pageEncoding="UTF-8" %>
<c:choose><c:when test="${view eq 'redeem'}"><h1>가맹점 혜택 사용</h1><p>이용권 코드를 입력하고 사용할 혜택을 확인해 주세요.</p><form method="post" action="${root}/merchant/redeem/lookup"><input type="hidden" name="csrf" value="${fn:escapeXml(csrf)}"><label>배정 가맹점<select name="merchantId" required><c:forEach var="item" items="${data}"><option value="${item.merchantId}"><c:out value="${item.name}"/></option></c:forEach></select></label><label>패스 코드<input name="code" maxlength="32" autocomplete="off" required></label><button>코드 조회</button></form></c:when>
<c:when test="${view eq 'confirm'}"><h1>혜택 확인</h1><p>확인 만료: <c:out value="${data.confirmationExpiresAtKst}"/></p><p>조회만으로는 사용 횟수가 줄어들지 않습니다.</p><c:forEach var="item" items="${data.benefits}"><article><h2><c:out value="${item.benefitName}"/></h2><p>잔여 <c:out value="${item.remainingCount}"/>회 · <c:out value="${item.reasonLabel}"/></p><form method="post" action="${root}/merchant/redeem/confirm"><input type="hidden" name="csrf" value="${fn:escapeXml(csrf)}"><input type="hidden" name="confirmationToken" value="${fn:escapeXml(data.confirmationToken)}"><input type="hidden" name="issuedBenefitId" value="${item.issuedBenefitId}"><button ${item.usable ? '' : 'disabled'}>사용 확인</button></form></article></c:forEach><a href="${root}/merchant/redeem">다른 코드 조회</a></c:when>
<c:when test="${view eq 'history'}"><h1>사용 이력</h1><c:if test="${user.role eq 'STAFF'}"><form method="get" action="${root}/merchant/history"><label>배정 가맹점<select name="merchantId"><c:forEach var="item" items="${assignments}"><option value="${item.merchantId}" ${param.merchantId eq item.merchantId ? 'selected' : ''}><c:out value="${item.name}"/></option></c:forEach></select></label><button>조회</button></form></c:if><c:if test="${empty data}"><p>성공한 사용 이력이 없습니다.</p></c:if><c:forEach var="item" items="${data}"><article><h2><c:out value="${item.benefitName}"/></h2><p><c:out value="${item.merchantName}"/> · <c:out value="${item.usedAtKst}"/> · <c:out value="${item.resultLabel}"/></p><p>시연용·실제 사용 불가</p><c:if test="${user.role eq 'VISITOR'}"><a href="${root}/feedback/edit?id=${item.id}">피드백 작성·수정</a></c:if></article></c:forEach></c:when>
<c:when test="${view eq 'feedback'}"><h1>이용 후 피드백</h1><p><c:out value="${data.redemption.benefitName}"/> · <c:out value="${data.redemption.usedAtKst}"/></p><p>본인에게만 공개되며 다음 추천의 개인 선호에 반영됩니다.</p>
<form method="post" action="${root}/feedback/${empty data.feedback ? 'create' : 'update'}"><input type="hidden" name="csrf" value="${fn:escapeXml(csrf)}"><input type="hidden" name="id" value="${data.redemption.id}"><label>만족도<select name="rating" required><c:forEach var="rating" begin="1" end="5"><option value="${rating}" ${data.feedback.rating eq rating ? 'selected' : ''}>${rating}점</option></c:forEach></select></label><fieldset><legend>선택 사유 · 복수 선택</legend><c:forTokens var="reason" items="INTEREST,COMPANION_FIT,COST,GUIDANCE" delims=","><c:set var="reasonChecked" value="false"/><c:forEach var="saved" items="${data.feedback.reasons}"><c:if test="${saved eq reason}"><c:set var="reasonChecked" value="true"/></c:if></c:forEach><label><input type="checkbox" name="reasons" value="${reason}" ${reasonChecked ? 'checked' : ''}> <c:out value="${reason eq 'INTEREST' ? '흥미' : reason eq 'COMPANION_FIT' ? '동반 적합' : reason eq 'COST' ? '비용' : '안내'}"/></label></c:forTokens></fieldset><label>의견 · 선택 · 500자 이내<textarea name="comment" maxlength="500"><c:out value="${data.feedback.comment}"/></textarea></label><button>피드백 저장</button></form>
<c:if test="${not empty data.feedback}"><form method="post" action="${root}/feedback/delete"><input type="hidden" name="csrf" value="${fn:escapeXml(csrf)}"><input type="hidden" name="id" value="${data.redemption.id}"><button>피드백 삭제</button></form></c:if></c:when></c:choose>
