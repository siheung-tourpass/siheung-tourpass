<%@ page pageEncoding="UTF-8" %>
<label class="place-pick"><input type="checkbox" name="cardKey" value="${fn:escapeXml(card.key)}" aria-label="${fn:escapeXml(card.name)} 선택" ${card.selected ? 'checked' : ''}><span>여행에 담기</span></label>
<button type="button" class="card-flip" data-flip="back" aria-label="${fn:escapeXml(card.name)} 상세 정보" hidden><span><c:out value="${cardDetails}"/></span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></button>
<button type="button" class="card-select-toggle" aria-label="${fn:escapeXml(card.name)} 여행 선택" aria-pressed="${card.selected ? 'true' : 'false'}" hidden></button>
