<%@ page pageEncoding="UTF-8" %>
<c:if test="${not empty cover.coverImage or not empty cover.description}"><c:set var="creditId" value="pass-credit-${empty cover.id ? cover.code : cover.id}"/><div class="pass-cover-credit"><button type="button" class="pass-cover-trigger" popovertarget="${fn:escapeXml(creditId)}" aria-haspopup="dialog"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5m0-9v.1"/></svg>${empty cover.description ? '사진 출처' : '구성·출처'}</button><section class="pass-cover-popover" id="${fn:escapeXml(creditId)}" popover role="dialog" aria-labelledby="${fn:escapeXml(creditId)}-title"><div class="pass-cover-popover-heading"><h2 id="${fn:escapeXml(creditId)}-title">${empty cover.description ? '사진 출처' : '구성·사진 출처'}</h2><button type="button" class="secondary" popovertarget="${fn:escapeXml(creditId)}" popovertargetaction="hide" autofocus>닫기</button></div><c:if test="${not empty cover.description}"><p><c:out value="${cover.description}"/></p></c:if><c:if test="${not empty cover.coverImage}"><p><c:out value="${cover.coverImage.alt}"/> · <c:out value="${empty cover.coverImage.author ? cover.coverImage.attribution : cover.coverImage.author}"/> · <c:set var="creditImage" value="${cover.coverImage}"/><c:set var="creditSourceLabel" value="원본 출처"/><c:set var="creditLicenseLabel" value="${cover.coverImage.license}"/><%@ include file="image-credit-links.jspf" %> · ${cover.coverKind eq 'EVENT' ? '원본 비율 유지·편집 없음' : '화면 표시: 크롭·원본 파일 보존'}</p></c:if></section></div></c:if>
