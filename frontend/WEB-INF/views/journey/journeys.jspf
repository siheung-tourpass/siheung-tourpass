<%@ page pageEncoding="UTF-8" %>
<c:choose><c:when test="${view eq 'journeys'}">
<h1>${journeyText.title}</h1>
<p>${journeyText.intro}</p>
<div class="section-heading"><h2>${journeyText.section} <span class="count">${fn:length(data)}개</span></h2><c:if test="${journeyStatus eq 'PLANNING'}"><a class="button" href="${root}/merchants">새 여행 만들기</a></c:if></div>
<c:if test="${empty data}"><div class="empty-state"><h3>${journeyText['empty']}</h3><p>${journeyText.emptyHint}</p><c:if test="${journeyStatus ne 'PLANNING'}"><a href="${root}/journeys">여행 패스 만들기 →</a></c:if></div></c:if>
<c:set var="journeyList" value="${data}"/><%@ include file="/WEB-INF/views/journey/journey-list.jspf" %>
</c:when><c:otherwise>
<article class="pass-card journey-business-card ${not empty data.coverImage ? 'has-cover' : ''}"><c:set var="cover" value="${data}"/><%@ include file="/WEB-INF/views/journey/journey-cover.jspf" %><div class="pass-card-main"><span class="journey-ticket-status"><c:out value="${data.statusLabel}"/></span><h1><c:out value="${data.name}"/></h1><p><c:out value="${empty data.travelDate ? '날짜 미정' : data.travelDate}"/> · ${fn:length(data.places)}장</p><%@ include file="/WEB-INF/views/journey/journey-cover-credit.jspf" %></div></article>
<c:choose><c:when test="${not empty data.benefitPass}"><section class="panel trip-pass" aria-labelledby="trip-pass-title"><p class="trip-pass-label">이 여행의 투어패스</p><h2 id="trip-pass-title"><c:out value="${data.benefitPass.productName}"/> <span class="journey-ticket-status"><c:out value="${data.benefitPass.statusLabel}"/></span></h2><p><c:out value="${data.benefitPass.startsAtKst}"/>부터 24시간</p><svg class="trip-pass-qr" viewBox="0 0 ${benefitPassQr.size} ${benefitPassQr.size}" role="img" aria-label="투어패스 코드 QR"><rect width="100%" height="100%" class="qr-paper"/><path d="${fn:escapeXml(benefitPassQr.path)}"/></svg><p class="code"><c:out value="${data.benefitPass.code}"/></p><p class="form-hint">가맹점에서 이 코드를 보여 주세요. 장소별 혜택은 아래 카드에 표시돼요.</p></section></c:when>
<c:when test="${not empty recommendedProduct}"><section class="panel trip-pass trip-offer" aria-labelledby="trip-offer-title"><p class="trip-pass-label">이 여행에 맞는 투어패스</p><h2 id="trip-offer-title"><c:out value="${recommendedProduct.name}"/></h2><p>담은 장소 중 <strong>${recommendedProduct.matchedCount}곳</strong>에서 혜택을 받을 수 있어요.</p><ul class="guide-benefit-list"><c:forEach var="benefit" items="${recommendedProduct.matchedBenefits}"><li><strong><c:out value="${benefit.placeName}"/></strong> <c:out value="${benefit.name}"/></li></c:forEach></ul><a class="button" href="${root}/passes/checkout?productId=${recommendedProduct.id}&amp;journeyId=${data.id}"><fmt:formatNumber value="${recommendedProduct.priceWon}"/>원 · 구매하기</a></section></c:when></c:choose>
<details><summary>이름·날짜 바꾸기</summary><form method="post" action="${root}/journeys/save"><%@ include file="/WEB-INF/views/shared/csrf.jspf" %><input type="hidden" name="id" value="${data.id}">
<label>패스 이름<input name="name" maxlength="100" required value="${fn:escapeXml(data.name)}"></label><label>여행 날짜<input type="date" name="travelDate" value="${fn:escapeXml(data.travelDate)}"></label>
<button>저장</button></form></details>
<c:if test="${data.status eq 'ARCHIVED'}"><p><a class="button" href="${root}/journeys/photocards?id=${data.id}">포토카드 보기</a></p><p>보관된 여행입니다. 기록은 계속 수정할 수 있습니다. 복원하면 내 투어패스의 진행 중인 여행으로 이동합니다.</p></c:if>
<c:if test="${empty data.places}"><p class="empty-state">저장된 장소가 없습니다.</p></c:if>
<p>장소 정보는 담을 당시 기준입니다. 방문 날짜와 만족도는 본인 기록이며 방문 인증이 아닙니다.</p>
<c:if test="${not empty data.places}"><section class="journey-records" aria-label="여행 카드별 기록"><div class="record-navigation" hidden><button type="button" id="record-previous" class="secondary" aria-label="이전 기록 카드">←</button><span id="record-position" role="status" aria-live="polite"></span><button type="button" id="record-next" class="secondary" aria-label="다음 기록 카드">→</button></div><div class="record-cards" tabindex="0" role="region" aria-label="좌우로 넘겨 여행 기록 작성"><c:forEach var="p" items="${data.places}" varStatus="order"><article class="journey-record-card destination-card" id="record-${p.id}"><c:set var="badgeBenefits" value="${p.tourpassBenefits}"/><%@ include file="/WEB-INF/views/shared/benefit-badge.jspf" %><h2>${order.count}. <c:out value="${p.placeName}"/></h2><p>${p.cardKind eq 'EVENT' ? '행사' : p.cardKind eq 'MERCHANT' ? '가맹점' : p.cardKind eq 'DINING' ? '음식점·카페' : '관광지'}</p><p><c:out value="${p.regionName}"/> · <c:out value="${p.locationDescription}"/> · <c:out value="${p.materialKind eq 'REAL' ? '실제 관광 소개' : '시연 자료'}"/></p>
<p><c:out value="${empty p.visitedOn ? '방문 전' : '다녀옴 · 본인 기록'}"/> <c:out value="${p.visitedOn}"/></p>

<form method="post" action="${root}/journeys/record"><div class="record-fields"><%@ include file="/WEB-INF/views/shared/csrf.jspf" %><input type="hidden" name="id" value="${data.id}"><input type="hidden" name="itemId" value="${p.id}"><label>방문 날짜<input type="date" name="visitedOn" aria-describedby="record-hint-${p.id}" value="${fn:escapeXml(p.visitedOn)}"></label><label>만족도<select name="rating" aria-describedby="record-hint-${p.id}"><option value="">선택 안 함</option><c:forEach var="score" begin="1" end="5"><option value="${score}" ${p.rating eq score ? 'selected' : ''}>${score}점</option></c:forEach></select></label></div><p class="form-hint" id="record-hint-${p.id}">날짜를 비우면 방문 전으로 표시해요. 만족도는 방문 후 선택해 주세요.</p><label>나만의 메모<textarea name="note" maxlength="500" rows="3" placeholder="기억에 남는 경험이나 다음에 다시 해보고 싶은 일을 남겨 보세요."><c:out value="${p.note}"/></textarea></label><button>기록 저장</button></form>
<section class="record-photo"><h3>내가 찍은 사진</h3><c:if test="${p.hasPhoto}"><img src="${root}/journeys/photo?id=${data.id}&amp;itemId=${p.id}" alt="${fn:escapeXml(p.placeName)}에서 찍은 사진" loading="lazy"></c:if>
<form method="post" enctype="multipart/form-data" action="${root}/journeys/photo"><%@ include file="/WEB-INF/views/shared/csrf.jspf" %><input type="hidden" name="id" value="${data.id}"><input type="hidden" name="itemId" value="${p.id}"><label>사진 ${p.hasPhoto ? '교체' : '선택'}<input type="file" name="photo" accept="image/jpeg,image/png" required aria-describedby="photo-help-${p.id}"></label><p class="form-hint" id="photo-help-${p.id}">직접 촬영한 JPEG·PNG, 8MB·1,600만 화소 이하. 본인만 볼 수 있으며 사용 완료 후 포토카드로 출력할 수 있어요.</p><button>${p.hasPhoto ? '사진 교체' : '사진 저장'}</button></form>
<c:if test="${p.hasPhoto}"><form method="post" action="${root}/journeys/photo"><%@ include file="/WEB-INF/views/shared/csrf.jspf" %><input type="hidden" name="id" value="${data.id}"><input type="hidden" name="itemId" value="${p.id}"><button class="secondary" name="intent" value="delete">사진 삭제</button></form></c:if></section></article></c:forEach>
</div></section><script src="${root}/assets/js/card-scroll.js" defer></script><script src="${root}/assets/js/journey-records.js" defer></script></c:if>
</c:otherwise></c:choose>
