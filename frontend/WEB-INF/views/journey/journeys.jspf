<%@ page pageEncoding="UTF-8" %>
<c:choose><c:when test="${view eq 'journeys'}">
<h1>${journeyText.title}</h1>
<p>${journeyText.intro}</p>
<div class="section-heading"><h2>${journeyText.section} <span class="count">${fn:length(data)}개</span></h2><c:if test="${journeyStatus eq 'PLANNING'}"><a class="button" href="${root}/merchants">새 여행 만들기</a></c:if></div>
<c:if test="${empty data}"><div class="empty-state"><h3>${journeyText['empty']}</h3><p>${journeyText.emptyHint}</p><c:if test="${journeyStatus ne 'PLANNING'}"><a href="${root}/journeys">여행 패스 만들기 →</a></c:if></div></c:if>
<c:set var="journeyList" value="${data}"/><%@ include file="/WEB-INF/views/journey/journey-list.jspf" %>
</c:when><c:otherwise>
<article class="pass-card journey-business-card ${not empty data.coverImage ? 'has-cover' : ''}"><c:set var="cover" value="${data}"/><%@ include file="/WEB-INF/views/journey/journey-cover.jspf" %><div class="pass-card-main"><span class="journey-ticket-status"><c:out value="${data.statusLabel}"/></span><h1><c:out value="${data.name}"/></h1><p><c:out value="${empty data.travelDate ? '날짜 미정' : data.travelDate}"/> · ${fn:length(data.places)}장</p><%@ include file="/WEB-INF/views/journey/journey-cover-credit.jspf" %></div></article>
<c:if test="${data.status ne 'ARCHIVED'}"><c:choose><c:when test="${not empty data.benefitPass}"><section class="panel trip-pass" aria-labelledby="trip-pass-title"><p class="trip-pass-label">이 여행의 투어패스</p><h2 id="trip-pass-title"><c:out value="${data.benefitPass.productName}"/> <span class="journey-ticket-status"><c:out value="${data.benefitPass.statusLabel}"/></span></h2><p><c:out value="${data.benefitPass.startsAtKst}"/>부터 24시간</p><c:if test="${not empty benefitPassQr}"><c:if test="${not empty benefitPassRemaining}"><p class="mypass-remaining"><span>남은 시간</span><strong><c:out value="${benefitPassRemaining}"/></strong></p></c:if><p class="mypass-code-label">가맹점에 제시할 코드</p><svg class="trip-pass-qr" viewBox="0 0 ${benefitPassQr.size} ${benefitPassQr.size}" role="img" aria-label="투어패스 코드 QR"><rect width="100%" height="100%" class="qr-paper"/><path d="${fn:escapeXml(benefitPassQr.path)}"/></svg><p class="code"><c:out value="${data.benefitPass.code}"/></p><p class="form-hint">담당자가 혜택을 확인하고 사용 처리하면 1회 차감돼요. 만료 <c:out value="${data.benefitPass.expiresAtKst}"/> · 만료 정각부터 사용 불가</p></c:if><c:if test="${passRefundable}"><c:set var="refundPass" value="${data.benefitPass}"/><%@ include file="/WEB-INF/views/pass/refund.jspf" %></c:if></section></c:when>
<c:when test="${not empty recommendedProduct}"><section class="panel trip-pass trip-offer" aria-labelledby="trip-offer-title"><p class="trip-pass-label">이 여행에 맞는 투어패스</p><h2 id="trip-offer-title"><c:out value="${recommendedProduct.name}"/></h2><p>담은 장소 중 <strong>${recommendedProduct.matchedCount}곳</strong>에서 혜택을 받을 수 있어요.</p><ul class="guide-benefit-list"><c:forEach var="benefit" items="${recommendedProduct.matchedBenefits}"><li><strong><c:out value="${benefit.placeName}"/></strong> <c:out value="${benefit.name}"/></li></c:forEach></ul><a class="button" href="${root}/passes/checkout?productId=${recommendedProduct.id}&amp;journeyId=${data.id}"><fmt:formatNumber value="${recommendedProduct.priceWon}"/>원 · 구매하기</a></section></c:when></c:choose>
<details><summary>이름·날짜 바꾸기</summary><form method="post" action="${root}/journeys/save"><%@ include file="/WEB-INF/views/shared/csrf.jspf" %><input type="hidden" name="id" value="${data.id}">
<label>패스 이름<input name="name" maxlength="100" required value="${fn:escapeXml(data.name)}"></label><label>여행 날짜<input type="date" name="travelDate" value="${fn:escapeXml(data.travelDate)}"></label>
<button>저장</button></form></details></c:if>
<c:if test="${empty data.places}"><p class="empty-state">저장된 장소가 없습니다.</p></c:if>
<c:if test="${data.status ne 'ARCHIVED'}"><c:if test="${not empty data.places}"><section class="journey-stops" aria-labelledby="journey-stops-title"><h2 id="journey-stops-title">방문 순서</h2><ol><c:forEach var="p" items="${data.places}"><li><div><strong><c:out value="${p.placeName}"/></strong><span>${p.cardKind eq 'EVENT' ? '행사' : p.cardKind eq 'MERCHANT' ? '가맹점' : p.cardKind eq 'DINING' ? '음식점·카페' : '관광지'} · <c:out value="${p.regionName}"/> · <c:out value="${p.locationDescription}"/></span><c:set var="badgeBenefits" value="${p.tourpassBenefits}"/><%@ include file="/WEB-INF/views/shared/benefit-badge.jspf" %></div></li></c:forEach></ol></section></c:if>
<p class="form-hint">장소 정보는 담을 당시 기준입니다. 여행 패스는 만료되지 않아요. 관광지·행사·음식점 안내는 영업·예약·이동 가능성을 보장하지 않으니 방문 전 공식 안내를 확인하세요.</p>
<form class="journey-finish" method="post" action="${root}/journeys/save"><%@ include file="/WEB-INF/views/shared/csrf.jspf" %><input type="hidden" name="id" value="${data.id}"><button name="status" value="ARCHIVED">여행 마치고 기록 남기기</button><p class="form-hint">방문 날짜·만족도·메모·사진은 여행을 마친 뒤에 남겨요. 마친 여행은 진행 중으로 되돌릴 수 없어요.</p></form></c:if>
<c:if test="${data.status eq 'ARCHIVED' and not empty data.places}"><section class="trip-story" aria-labelledby="trip-story-title"><h2 id="trip-story-title">이렇게 다녀왔어요</h2><p class="trip-story-lead"><c:out value="${tripStory.lead}"/></p><p class="trip-story-stats"><c:out value="${tripStory.stats}"/></p>
<ol class="trip-stops"><c:forEach var="p" items="${data.places}" varStatus="order"><li class="trip-stop" id="record-${p.id}"><span class="trip-stop-no" aria-hidden="true">${order.count}</span><div class="trip-stop-body">
<h3><c:out value="${p.placeName}"/></h3><p class="trip-stop-meta">${p.cardKind eq 'EVENT' ? '행사' : p.cardKind eq 'MERCHANT' ? '가맹점' : p.cardKind eq 'DINING' ? '음식점·카페' : '관광지'} · <c:out value="${p.regionName}"/> · <c:out value="${p.locationDescription}"/></p>
<p class="trip-stop-visit"><c:choose><c:when test="${empty p.visitedOn}">방문 기록 없음</c:when><c:otherwise><c:out value="${p.visitedLabel}"/> 다녀옴</c:otherwise></c:choose><c:if test="${not empty p.rating}"> <span class="star-view" role="img" aria-label="만족도 ${p.rating}점"><c:forEach var="star" begin="1" end="5"><span class="${star le p.rating ? 'is-on' : ''}" aria-hidden="true">★</span></c:forEach></span></c:if></p>
<c:set var="badgeBenefits" value="${p.tourpassBenefits}"/><%@ include file="/WEB-INF/views/shared/benefit-badge.jspf" %>
<c:if test="${not empty p.note}"><p class="trip-stop-note"><c:out value="${p.note}"/></p></c:if>
<c:if test="${p.hasPhoto}"><img class="trip-stop-photo" src="${root}/journeys/photo?id=${data.id}&amp;itemId=${p.id}" alt="${fn:escapeXml(p.placeName)}에서 찍은 사진" loading="lazy"></c:if>
<details class="trip-stop-edit"><summary>${empty p.visitedOn and empty p.note and not p.hasPhoto ? '기록 남기기' : '기록 수정'}</summary>
<form class="record-form" method="post" action="${root}/journeys/record" data-default-visit="${tripStory.defaultVisit}"><%@ include file="/WEB-INF/views/shared/csrf.jspf" %><input type="hidden" name="id" value="${data.id}"><input type="hidden" name="itemId" value="${p.id}">
<fieldset class="star-rating"><legend>만족도</legend><input type="radio" class="visually-hidden" id="rating-${p.id}-0" name="rating" value="" ${empty p.rating ? 'checked' : ''}><label class="star-clear" for="rating-${p.id}-0">선택 안 함</label><c:forEach var="score" begin="1" end="5"><input type="radio" class="visually-hidden" id="rating-${p.id}-${score}" name="rating" value="${score}" ${p.rating eq score ? 'checked' : ''}><label class="star" for="rating-${p.id}-${score}"><span class="visually-hidden">${score}점</span></label></c:forEach></fieldset>
<label>방문 날짜<input type="date" name="visitedOn" value="${fn:escapeXml(p.visitedOn)}"></label>
<label>메모<textarea name="note" maxlength="500" rows="3" placeholder="기억에 남는 순간을 적어 보세요."><c:out value="${p.note}"/></textarea></label>
<p class="form-hint">방문 날짜를 비우면 방문 기록이 지워지고, 별점은 방문 날짜가 있어야 저장돼요.</p><button>기록 저장</button></form>
<div class="record-photo"><form method="post" enctype="multipart/form-data" action="${root}/journeys/photo"><%@ include file="/WEB-INF/views/shared/csrf.jspf" %><input type="hidden" name="id" value="${data.id}"><input type="hidden" name="itemId" value="${p.id}"><label class="button secondary record-photo-pick">${p.hasPhoto ? '사진 바꾸기' : '사진 올리기'}<input class="visually-hidden" type="file" name="photo" accept="image/jpeg,image/png" required aria-describedby="photo-help-${p.id}"></label><button class="record-photo-submit">사진 저장</button></form>
<c:if test="${p.hasPhoto}"><form method="post" action="${root}/journeys/photo"><%@ include file="/WEB-INF/views/shared/csrf.jspf" %><input type="hidden" name="id" value="${data.id}"><input type="hidden" name="itemId" value="${p.id}"><button class="secondary" name="intent" value="delete">사진 삭제</button></form></c:if>
<p class="form-hint" id="photo-help-${p.id}">직접 찍은 JPEG·PNG 한 장(8MB·1,600만 화소 이하). 나만 볼 수 있고 포토카드로 출력할 수 있어요.</p></div>
</details></div></li></c:forEach></ol>
<p><a class="button secondary" href="${root}/journeys/photocards?id=${data.id}">포토카드 보기</a></p>
<p class="form-hint">방문 날짜와 별점은 내가 남긴 기록이며 방문 인증이 아니에요. 장소 정보는 담을 당시 기준이에요.</p></section><script src="${root}/assets/js/journey-records.js" defer></script></c:if>
</c:otherwise></c:choose>
