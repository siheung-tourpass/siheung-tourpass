<%@ page pageEncoding="UTF-8" %>
<c:if test="${user.role eq 'ADMIN'}"><%@ include file="/WEB-INF/views/admin/admin-nav.jspf" %></c:if>
<c:choose><c:when test="${view eq 'passes' and user.role eq 'VISITOR'}"><h1>내 투어패스</h1>
<c:if test="${not empty activeJourneys}"><section aria-labelledby="active-journeys-title"><h2 id="active-journeys-title">진행 중인 여행</h2><p>여행을 열어 투어패스를 구매하거나 방문 기록을 남기고, 여행을 마치면 사용 완료로 보관하세요.</p><c:set var="journeyList" value="${activeJourneys}"/><%@ include file="/WEB-INF/views/journey/journey-list.jspf" %></section></c:if>
<section class="panel mypass" aria-labelledby="mypass-active-title"><h2 id="mypass-active-title">현재 투어패스</h2>
<c:choose><c:when test="${not empty activeBenefitPass}"><p class="mypass-name"><c:out value="${activeBenefitPass.productName}"/> <span class="journey-ticket-status"><c:out value="${activeBenefitPass.statusLabel}"/></span></p><c:choose><c:when test="${not empty activeBenefitPassRemaining}"><p class="mypass-remaining"><span>남은 시간</span><strong><c:out value="${activeBenefitPassRemaining}"/></strong></p></c:when><c:otherwise><p class="mypass-remaining"><span>시작</span><strong><c:out value="${activeBenefitPass.startsAtKst}"/></strong></p></c:otherwise></c:choose>
<p class="mypass-code-label">가맹점에 제시할 코드</p><svg class="trip-pass-qr" viewBox="0 0 ${benefitPassQr.size} ${benefitPassQr.size}" role="img" aria-label="투어패스 코드 QR"><rect width="100%" height="100%" class="qr-paper"/><path d="${fn:escapeXml(benefitPassQr.path)}"/></svg><p class="code"><c:out value="${activeBenefitPass.code}"/></p><p>담당자가 혜택을 확인하고 사용 처리하면 1회 차감돼요. 만료 <c:out value="${activeBenefitPass.expiresAtKst}"/> · 만료 정각부터 사용 불가</p>
<h3>포함 혜택 · 각 1회</h3><ul class="guide-benefit-list"><c:forEach var="benefit" items="${activeBenefitPass.benefits}"><li><strong><c:out value="${benefit.merchantName}"/></strong> <c:out value="${benefit.benefitName}"/> · 잔여 <c:out value="${benefit.remainingCount}"/>회 · <c:out value="${benefit.reasonLabel}"/></li></c:forEach></ul></c:when>
<c:otherwise><p>아직 투어패스가 없어요. 여행을 만들면 맞는 투어패스를 추천해 드려요.</p><a class="button" href="${root}/journeys">여행 만들기</a></c:otherwise></c:choose></section>
<section class="guide-section" aria-labelledby="mypass-history-title"><h2 id="mypass-history-title">혜택 사용 이력</h2>
<c:if test="${empty benefitHistory}"><p>아직 사용한 혜택이 없어요.</p></c:if>
<c:forEach var="item" items="${benefitHistory}"><article class="pass-card"><div class="pass-card-main"><h3><c:out value="${item.benefitName}"/></h3><p><c:out value="${item.merchantName}"/> · <c:out value="${item.usedAtKst}"/></p></div><div class="pass-card-action"><a class="button secondary" href="${root}/feedback/edit?id=${item.id}">피드백</a></div></article></c:forEach></section>
<c:if test="${not empty data}"><section class="guide-section" aria-labelledby="mypass-all-title"><h2 id="mypass-all-title">구매 내역</h2>
<c:forEach var="item" items="${data}"><a class="pass-row" href="${root}/passes/detail?id=${item.id}"><span><strong><c:out value="${item.productName}"/></strong><small>이용 <c:out value="${item.startsAtKst}"/> · 만료 <c:out value="${item.expiresAtKst}"/></small></span><span class="journey-ticket-status"><c:out value="${item.statusLabel}"/></span></a></c:forEach></section></c:if></c:when>
<c:when test="${view eq 'passes'}"><h1>이용권 관리</h1><c:if test="${empty data}"><div class="empty-state"><h2>아직 발급한 이용권이 없어요</h2><p>상품의 혜택과 이용 조건을 확인한 뒤 발급하세요.</p><a class="button" href="${root}/merchants">혜택 상품 보기</a></div></c:if><c:forEach var="item" items="${data}"><article class="pass-card"><div class="pass-card-main"><h2><a href="${root}/admin/passes/detail?id=${item.id}"><c:out value="${item.productName}"/></a></h2><p>발급 <c:out value="${item.startsAtKst}"/> · 만료 <c:out value="${item.expiresAtKst}"/></p></div><div class="pass-card-action"><span class="journey-ticket-status"><c:out value="${item.statusLabel}"/></span><a class="button secondary" href="${root}/admin/passes/detail?id=${item.id}">이용권 보기</a></div></article></c:forEach></c:when>
<c:otherwise><article class="pass-card"><div class="pass-card-main"><h1><c:out value="${data.productName}"/></h1><p>상태: <c:out value="${data.statusLabel}"/></p><dl><dt>시작</dt><dd><c:out value="${data.startsAtKst}"/></dd><dt>만료</dt><dd><c:out value="${data.expiresAtKst}"/> · 만료 정각부터 사용 불가</dd><c:if test="${not empty data.cancelledAt}"><dt>취소</dt><dd><c:out value="${data.cancelledAtKst}"/> · <c:out value="${data.cancelReason}"/></dd></c:if></dl></div><div class="pass-card-action"><span class="journey-ticket-status"><c:out value="${data.statusLabel}"/></span></div></article>
<c:if test="${user.role eq 'VISITOR'}"><h2>가맹점에 제시할 코드</h2><svg class="trip-pass-qr" viewBox="0 0 ${benefitPassQr.size} ${benefitPassQr.size}" role="img" aria-label="투어패스 코드 QR"><rect width="100%" height="100%" class="qr-paper"/><path d="${fn:escapeXml(benefitPassQr.path)}"/></svg><p class="code"><c:out value="${data.code}"/></p><p>담당자에게 코드를 보여 주세요. 혜택을 확인하고 사용 처리하면 1회 차감됩니다.</p></c:if>
<c:if test="${user.role eq 'ADMIN' and data.status ne 'EXPIRED' and data.status ne 'CANCELLED'}"><form method="post" action="${root}/admin/passes/cancel"><%@ include file="/WEB-INF/views/shared/csrf.jspf" %><input type="hidden" name="id" value="${data.id}"><label>취소 사유<textarea name="reason" maxlength="500" required></textarea></label><button>이용권 취소</button></form></c:if>
<c:set var="benefits" value="${data.benefits}"/><%@ include file="/WEB-INF/views/pass/benefits.jspf" %></c:otherwise></c:choose>
