<%@ page pageEncoding="UTF-8" %>
<section id="journey-start-picker" class="pass-cover-popover journey-start-picker" popover role="dialog" aria-labelledby="journey-start-title"><div class="pass-cover-popover-heading"><h2 id="journey-start-title">시작 구성을 선택하세요</h2><button type="button" class="secondary" popovertarget="journey-start-picker" popovertargetaction="hide" aria-label="시작 구성 선택 닫기" autofocus>닫기</button></div><p>빈 구성에서 시작하거나 미리 담아 둔 장소를 골라 보세요. 저장 전까지 자유롭게 바꿀 수 있습니다.</p><div class="journey-template-grid">
<article class="journey-template pass-card journey-business-card"><div class="pass-card-main"><h3>빈 구성</h3><p>처음부터 원하는 카드를 직접 골라요.</p><p class="result-meta">선택 카드 0장</p><a class="button secondary" href="${root}/journeys/new">빈 구성으로 시작</a></div></article>
<c:forEach var="template" items="${journeyTemplates}"><article class="journey-template pass-card journey-business-card ${not empty template.coverImage ? 'has-cover' : ''}"><c:set var="cover" value="${template}"/><%@ include file="journey-cover.jspf" %><div class="pass-card-main"><h3><c:out value="${template.name}"/></h3><p class="result-meta">관광지 ${template.cardCount}장</p><c:choose><c:when test="${template.available}"><a class="button secondary" href="${root}/journeys/new?template=${template.code}" aria-label="${fn:escapeXml(template.name)} 템플릿으로 시작">템플릿 선택</a></c:when><c:otherwise><p class="form-hint">장소 자료 준비 중</p></c:otherwise></c:choose><%@ include file="journey-cover-credit.jspf" %></div></article></c:forEach>
</div></section>
