<%@ page pageEncoding="UTF-8" %>
<c:choose><c:when test="${view eq 'journeys'}">
<h1>나의 여행 패스</h1><p>가고 싶은 장소를 담고, 다녀온 경험을 간직하세요. 여행 패스에는 만료일이 없습니다.</p>
<nav aria-label="여행 목록"><a href="${root}/journeys" ${empty param.status ? 'aria-current=page' : ''}>전체</a><a href="${root}/journeys?status=PLANNING" ${param.status eq 'PLANNING' ? 'aria-current=page' : ''}>구성 중</a><a href="${root}/journeys?status=ARCHIVED" ${param.status eq 'ARCHIVED' ? 'aria-current=page' : ''}>아카이브</a></nav>
<h2>새 여행 패스</h2><form method="post" action="${root}/journeys/create"><input type="hidden" name="csrf" value="${fn:escapeXml(csrf)}"><label>패스 이름<input name="name" maxlength="100" required placeholder="나의 시흥 여행"></label><label>여행 날짜 · 선택<input type="date" name="travelDate"></label><button>여행 패스 만들기</button></form>
<c:if test="${empty data}"><p class="empty-state">아직 여행 패스가 없습니다. 첫 여행을 만들어 보세요.</p></c:if>
<c:forEach var="j" items="${data}"><article><h2><a href="${root}/journeys/detail?id=${j.id}"><c:out value="${j.name}"/></a></h2><p><c:out value="${j.statusLabel}"/> · <c:out value="${empty j.travelDate ? '날짜 미정' : j.travelDate}"/> · <c:out value="${j.placeCount}"/>곳</p></article></c:forEach>
</c:when><c:otherwise>
<h1><c:out value="${data.name}"/></h1><p><c:out value="${data.statusLabel}"/> · <c:out value="${empty data.travelDate ? '날짜 미정' : data.travelDate}"/></p>
<p><a href="${root}/journeys">나의 여행 패스</a> · <a href="${root}/recommendations">추천 장소 담기</a></p>
<details><summary>이름·날짜·보관 상태·혜택 이용권 설정</summary><form method="post" action="${root}/journeys/save"><input type="hidden" name="csrf" value="${fn:escapeXml(csrf)}"><input type="hidden" name="id" value="${data.id}">
<label>패스 이름<input name="name" maxlength="100" required value="${fn:escapeXml(data.name)}"></label><label>여행 날짜<input type="date" name="travelDate" value="${fn:escapeXml(data.travelDate)}"></label>
<label>보관 상태<select name="status"><option value="PLANNING" ${data.status eq 'PLANNING' ? 'selected' : ''}>구성 중</option><option value="ARCHIVED" ${data.status eq 'ARCHIVED' ? 'selected' : ''}>여행 완료 · 아카이브</option></select></label>
<label>선택 혜택 이용권<select name="issuedPassId"><option value="">연결 안 함</option><c:forEach var="p" items="${benefitPasses}"><option value="${p.id}" ${data.issuedPassId eq p.id ? 'selected' : ''}><c:out value="${p.productName}"/> #${p.id} · <c:out value="${p.statusLabel}"/></option></c:forEach></select></label><button>설정 저장</button></form></details>
<c:if test="${data.status eq 'ARCHIVED'}"><p>보관된 여행입니다. 기록은 수정할 수 있고, 장소 구성은 설정에서 ‘구성 중’으로 되돌린 후 변경할 수 있습니다.</p></c:if>
<c:if test="${empty data.places}"><p class="empty-state">담은 장소가 없습니다. 관광 추천에서 장소를 선택해 주세요.</p></c:if>
<p>장소 정보는 담을 당시 기준입니다. 방문 날짜와 만족도는 본인 기록이며 방문 인증이 아닙니다.</p>
<c:forEach var="p" items="${data.places}" varStatus="order"><article><h2>${order.count}. <c:out value="${p.placeName}"/></h2><p><c:out value="${p.regionName}"/> · <c:out value="${p.locationDescription}"/> · <c:out value="${p.materialKind eq 'REAL' ? '실제 관광 소개' : '시연 자료·실제 사용 불가'}"/></p>
<p><c:out value="${empty p.visitedOn ? '방문 전' : '다녀옴 · 본인 기록'}"/> <c:out value="${p.visitedOn}"/></p>
<c:if test="${data.status eq 'PLANNING'}"><form class="inline" method="post" action="${root}/journeys/move"><input type="hidden" name="csrf" value="${fn:escapeXml(csrf)}"><input type="hidden" name="id" value="${data.id}"><input type="hidden" name="itemId" value="${p.id}"><button name="direction" value="UP" ${order.first ? 'disabled' : ''}>위로</button><button name="direction" value="DOWN" ${order.last ? 'disabled' : ''}>아래로</button></form><form class="inline" method="post" action="${root}/journeys/remove"><input type="hidden" name="csrf" value="${fn:escapeXml(csrf)}"><input type="hidden" name="id" value="${data.id}"><input type="hidden" name="itemId" value="${p.id}"><button>장소·기록 삭제</button></form></c:if>
<form method="post" action="${root}/journeys/record"><input type="hidden" name="csrf" value="${fn:escapeXml(csrf)}"><input type="hidden" name="id" value="${data.id}"><input type="hidden" name="itemId" value="${p.id}"><label>다녀온 날짜 · 비우면 방문 전<input type="date" name="visitedOn" value="${fn:escapeXml(p.visitedOn)}"></label><label>만족도 · 방문 후 선택<select name="rating"><option value="">선택 안 함</option><c:forEach var="score" begin="1" end="5"><option value="${score}" ${p.rating eq score ? 'selected' : ''}>${score}점</option></c:forEach></select></label><label>나만의 메모<textarea name="note" maxlength="500"><c:out value="${p.note}"/></textarea></label><button>기록 저장</button></form></article></c:forEach>
<h2>선택 혜택 이용권</h2><p>여행 패스에 장소를 담아도 혜택이 발급되거나 사용되지는 않습니다. 이용권의 24시간 유효기간은 여행 기록과 별개입니다.</p>
<c:choose><c:when test="${not empty data.benefitPass}"><p><a href="${root}/passes/detail?id=${data.issuedPassId}"><c:out value="${data.benefitPass.productName}"/></a> · <c:out value="${data.benefitPass.statusLabel}"/> · 시연용·실제 사용 불가</p><a href="${root}/feedback/history">확인된 혜택 사용 이력·피드백</a></c:when><c:otherwise><p>연결된 이용권이 없습니다. <a href="${root}/merchants">혜택 살펴보기</a> · <a href="${root}/passes">내 혜택 이용권</a></p></c:otherwise></c:choose>
</c:otherwise></c:choose>
