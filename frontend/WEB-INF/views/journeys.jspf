<%@ page pageEncoding="UTF-8" %>
<c:choose><c:when test="${view eq 'journeys'}">
<h1>${journeyStatus eq 'CONFIRMED' ? '내 패스' : journeyStatus eq 'ARCHIVED' ? '여행 기록' : '여행 만들기'}</h1>
<p>${journeyStatus eq 'CONFIRMED' ? '제작을 확정한 패스입니다. 여행을 마치면 사용 완료로 보관하세요.' : journeyStatus eq 'ARCHIVED' ? '사용을 마친 패스와 여행 기록을 아카이브에 보관합니다.' : '카드를 탐색해 새 패스를 제작하거나 임시 저장한 패스를 이어 만드세요.'}</p>
<c:if test="${journeyStatus eq 'PLANNING'}"><details class="journey-templates"><summary id="journey-templates-title">템플릿으로 시작하기</summary><p class="form-hint">장소를 미리 담아 두었어요. 이름과 구성은 자유롭게 바꿀 수 있습니다.</p><div class="journey-template-grid">
<c:forEach var="template" items="${journeyTemplates}"><article class="journey-template"><h3><c:out value="${template.name}"/></h3><p><c:out value="${template.description}"/></p><p class="result-meta">관광지 ${template.cardCount}장</p><c:choose><c:when test="${template.available}"><a class="button secondary" href="${root}/journeys/new?template=${template.code}" aria-label="${fn:escapeXml(template.name)} 템플릿으로 시작">이 구성으로 시작</a></c:when><c:otherwise><p class="form-hint">장소 자료 준비 중</p></c:otherwise></c:choose></article></c:forEach>
</div></details></c:if>
<div class="section-heading"><h2>${journeyStatus eq 'CONFIRMED' ? '제작 확정' : journeyStatus eq 'ARCHIVED' ? '아카이브' : '제작 중'} <span class="count">${fn:length(data)}개</span></h2><c:if test="${journeyStatus eq 'PLANNING'}"><a class="button" href="${root}/journeys/new">새 여행 만들기</a></c:if></div>
<c:if test="${empty data}"><div class="empty-state"><h3>${journeyStatus eq 'CONFIRMED' ? '제작을 확정한 패스가 없습니다' : journeyStatus eq 'ARCHIVED' ? '사용 완료한 패스가 없습니다' : '제작 중인 패스가 없습니다'}</h3><p>${journeyStatus eq 'ARCHIVED' ? '확정한 패스에서 사용 완료를 누르면 여기에 보관됩니다.' : '여행 만들기에서 카드를 골라 임시 저장하거나 제작을 확정해 보세요.'}</p><c:if test="${journeyStatus ne 'PLANNING'}"><a href="${root}/journeys">여행 패스 만들기 →</a></c:if></div></c:if>
<div class="journey-pass-list"><c:forEach var="j" items="${data}"><article class="journey-card journey-ticket" data-status="${j.status}"><div class="journey-ticket-main"><span class="journey-ticket-status"><c:out value="${j.statusLabel}"/></span><h2><a href="${root}/journeys/${j.status eq 'PLANNING' ? 'edit' : 'detail'}?id=${j.id}"><c:out value="${j.name}"/></a></h2><p class="journey-ticket-date">여행 날짜 · <c:out value="${empty j.travelDate ? '날짜 미정' : j.travelDate}"/></p><c:if test="${j.status eq 'PLANNING'}"><details class="journey-ticket-delete"><summary>패스 삭제</summary><p>임시 저장한 내용이 삭제되며 되돌릴 수 없습니다.</p><form method="post" action="${root}/journeys/delete"><input type="hidden" name="csrf" value="${fn:escapeXml(csrf)}"><input type="hidden" name="id" value="${j.id}"><button>이 패스 삭제</button></form></details></c:if></div><div class="journey-ticket-stub"><div><span>선택 카드</span><strong>${j.placeCount}<small>장</small></strong></div><a class="button secondary" href="${root}/journeys/${j.status eq 'PLANNING' ? 'edit' : 'detail'}?id=${j.id}">${j.status eq 'PLANNING' ? '이어 만들기' : '패스 보기'}</a></div></article></c:forEach></div>
<c:if test="${journeyStatus eq 'CONFIRMED'}"><p><a href="${root}/passes">시연 혜택 발급·이용권 관리</a></p></c:if>
<c:if test="${journeyStatus eq 'ARCHIVED'}"><p><a href="${root}/feedback/history">가맹점 혜택 사용 기록·평가</a></p></c:if>
</c:when><c:otherwise>
<h1><c:out value="${data.name}"/></h1><p><c:out value="${data.statusLabel}"/> · <c:out value="${empty data.travelDate ? '날짜 미정' : data.travelDate}"/></p>
<p><a href="${root}/journeys?status=${data.status}">목록으로</a></p>
<form class="inline" method="post" action="${root}/journeys/save"><input type="hidden" name="csrf" value="${fn:escapeXml(csrf)}"><input type="hidden" name="id" value="${data.id}"><button name="status" value="${data.status eq 'ARCHIVED' ? 'CONFIRMED' : 'ARCHIVED'}">${data.status eq 'ARCHIVED' ? '제작 확정 목록으로 복원' : '사용 완료 · 아카이브'}</button></form>
<details><summary>이름·날짜·혜택 이용권 설정</summary><form method="post" action="${root}/journeys/save"><input type="hidden" name="csrf" value="${fn:escapeXml(csrf)}"><input type="hidden" name="id" value="${data.id}">
<label>패스 이름<input name="name" maxlength="100" required value="${fn:escapeXml(data.name)}"></label><label>여행 날짜<input type="date" name="travelDate" value="${fn:escapeXml(data.travelDate)}"></label>
<label>선택 혜택 이용권<select name="issuedPassId"><option value="">연결 안 함</option><c:forEach var="p" items="${benefitPasses}"><option value="${p.id}" ${data.issuedPassId eq p.id ? 'selected' : ''}><c:out value="${p.productName}"/> #${p.id} · <c:out value="${p.statusLabel}"/></option></c:forEach></select></label><button>설정 저장</button></form></details>
<c:if test="${data.status eq 'ARCHIVED'}"><p>보관된 여행입니다. 기록은 계속 수정할 수 있습니다. 복원하면 제작 확정 목록으로 이동합니다.</p></c:if>
<c:if test="${empty data.places}"><p class="empty-state">저장된 장소가 없습니다.</p></c:if>
<p>장소 정보는 담을 당시 기준입니다. 방문 날짜와 만족도는 본인 기록이며 방문 인증이 아닙니다.</p>
<c:if test="${not empty data.places}"><section class="journey-records" aria-label="여행 카드별 기록"><div class="record-navigation" hidden><button type="button" id="record-previous" class="secondary" aria-label="이전 기록 카드">←</button><span id="record-position" role="status" aria-live="polite"></span><button type="button" id="record-next" class="secondary" aria-label="다음 기록 카드">→</button></div><div class="record-cards" tabindex="0" role="region" aria-label="좌우로 넘겨 여행 기록 작성"><c:forEach var="p" items="${data.places}" varStatus="order"><article class="journey-record-card" id="record-${p.id}" data-record-id="${p.id}"><h2>${order.count}. <c:out value="${p.placeName}"/></h2><p>${p.cardKind eq 'EVENT' ? '행사' : p.cardKind eq 'MERCHANT' ? '가맹점' : '관광지'}</p><p><c:out value="${p.regionName}"/> · <c:out value="${p.locationDescription}"/> · <c:out value="${p.materialKind eq 'REAL' ? '실제 관광 소개' : '시연 자료·실제 사용 불가'}"/></p>
<p><c:out value="${empty p.visitedOn ? '방문 전' : '다녀옴 · 본인 기록'}"/> <c:out value="${p.visitedOn}"/></p>

<form method="post" action="${root}/journeys/record"><div class="record-fields"><input type="hidden" name="csrf" value="${fn:escapeXml(csrf)}"><input type="hidden" name="id" value="${data.id}"><input type="hidden" name="itemId" value="${p.id}"><label>방문 날짜<input type="date" name="visitedOn" aria-describedby="record-hint-${p.id}" value="${fn:escapeXml(p.visitedOn)}"></label><label>만족도<select name="rating" aria-describedby="record-hint-${p.id}"><option value="">선택 안 함</option><c:forEach var="score" begin="1" end="5"><option value="${score}" ${p.rating eq score ? 'selected' : ''}>${score}점</option></c:forEach></select></label></div><p class="form-hint" id="record-hint-${p.id}">날짜를 비우면 방문 전으로 표시해요. 만족도는 방문 후 선택해 주세요.</p><label>나만의 메모<textarea name="note" maxlength="500" rows="3"><c:out value="${p.note}"/></textarea></label><button>기록 저장</button></form></article></c:forEach>
</div></section><script src="${root}/assets/card-scroll.js" defer></script><script src="${root}/assets/journey-records.js" defer></script></c:if>
<h2>선택 혜택 이용권</h2><p>여행 패스에 장소를 담아도 혜택이 발급되거나 사용되지는 않습니다. 이용권의 24시간 유효기간은 여행 기록과 별개입니다.</p>
<c:choose><c:when test="${not empty data.benefitPass}"><p><a href="${root}/passes/detail?id=${data.issuedPassId}"><c:out value="${data.benefitPass.productName}"/></a> · <c:out value="${data.benefitPass.statusLabel}"/> · 시연용·실제 사용 불가</p><a href="${root}/feedback/history">확인된 혜택 사용 이력·피드백</a></c:when><c:otherwise><p>연결된 이용권이 없습니다. <a href="${root}/merchants">혜택 살펴보기</a> · <a href="${root}/passes">내 혜택 이용권</a></p></c:otherwise></c:choose>
<h3>이용권 연결 이력</h3>
<c:if test="${empty data.benefitPassHistory}"><p>아직 연결 이력이 없습니다.</p></c:if>
<c:forEach var="link" items="${data.benefitPassHistory}"><article><h4><a href="${root}/passes/detail?id=${link.issuedPassId}"><c:out value="${link.productName}"/> #<c:out value="${link.issuedPassId}"/></a></h4><p><c:out value="${link.statusLabel}"/> · 시연용·실제 사용 불가</p><p>연결: <c:out value="${empty link.linkedAt ? '미확인' : link.linkedAtKst}"/> · <c:out value="${empty link.disconnectedAt ? '현재 연결 중' : '해제:'}"/> <c:out value="${link.disconnectedAtKst}"/></p></article></c:forEach>
</c:otherwise></c:choose>
