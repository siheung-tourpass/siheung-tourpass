<%@ page pageEncoding="UTF-8" %>
<c:choose><c:when test="${view eq 'journeys'}">
<h1>${journeyText.title}</h1>
<p>${journeyText.intro}</p>
<c:if test="${journeyStatus eq 'PLANNING'}"><%@ include file="journey-start-picker.jspf" %></c:if>
<div class="section-heading"><h2>${journeyText.section} <span class="count">${fn:length(data)}개</span></h2><c:if test="${journeyStatus eq 'PLANNING'}"><button type="button" popovertarget="journey-start-picker" aria-haspopup="dialog">새 여행 만들기</button></c:if></div>
<c:if test="${empty data}"><div class="empty-state"><h3>${journeyText['empty']}</h3><p>${journeyText.emptyHint}</p><c:if test="${journeyStatus ne 'PLANNING'}"><a href="${root}/journeys">여행 패스 만들기 →</a></c:if></div></c:if>
<div class="journey-pass-list"><c:forEach var="j" items="${data}"><article class="journey-card pass-card journey-business-card ${not empty j.coverImage ? 'has-cover' : ''}" data-status="${j.status}"><c:set var="cover" value="${j}"/><%@ include file="journey-cover.jspf" %><div class="pass-card-main"><span class="journey-ticket-status"><c:out value="${j.statusLabel}"/></span><h2><a class="journey-card-link" aria-label="${fn:escapeXml(j.name)} · ${j.status eq 'PLANNING' ? '이어 만들기' : '패스 보기'}" href="${root}/journeys/${j.status eq 'PLANNING' ? 'edit' : 'detail'}?id=${j.id}"><c:out value="${j.name}"/></a></h2><p class="journey-ticket-date"><c:out value="${empty j.travelDate ? '날짜 미정' : j.travelDate}"/> · ${j.placeCount}장</p><%@ include file="journey-cover-credit.jspf" %><c:if test="${j.status eq 'PLANNING'}"><button type="button" class="journey-ticket-delete" popovertarget="pass-delete-${j.id}" aria-haspopup="dialog" aria-label="패스 삭제" title="패스 삭제"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13M10 11v5m4-5v5"/></svg><span class="visually-hidden">패스 삭제</span></button><section id="pass-delete-${j.id}" class="pass-cover-popover journey-delete-popover" popover role="dialog" aria-labelledby="pass-delete-${j.id}-title"><div class="pass-cover-popover-heading"><h2 id="pass-delete-${j.id}-title">패스 삭제</h2><button type="button" class="secondary" popovertarget="pass-delete-${j.id}" popovertargetaction="hide" autofocus>닫기</button></div><p>임시 저장한 내용이 삭제되며 되돌릴 수 없습니다.</p><form method="post" action="${root}/journeys/delete"><%@ include file="csrf.jspf" %><input type="hidden" name="id" value="${j.id}"><button>이 패스 삭제</button></form></section></c:if><c:if test="${j.status ne 'PLANNING'}">
<c:set var="statusPopupLabel" value="${j.status eq 'ARCHIVED' ? '제작 확정 목록으로 복원' : '패스 상태 변경'}"/>
<c:set var="statusActionLabel" value="${j.status eq 'ARCHIVED' ? '제작 확정 목록으로 복원' : '사용 완료 · 아카이브'}"/>
<button type="button" class="journey-ticket-action" popovertarget="pass-status-${j.id}" aria-haspopup="dialog" aria-label="${statusPopupLabel}" title="${statusPopupLabel}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><c:choose><c:when test="${j.status eq 'ARCHIVED'}"><path d="M3 10a9 9 0 1 1 2 8M3 4v6h6"/></c:when><c:otherwise><path d="M4 4h16v4H4zM6 8v12h12V8M10 12h4"/></c:otherwise></c:choose></svg><span class="visually-hidden">${statusPopupLabel}</span></button>
<section id="pass-status-${j.id}" class="pass-cover-popover" popover role="dialog" aria-labelledby="pass-status-${j.id}-title"><div class="pass-cover-popover-heading"><h2 id="pass-status-${j.id}-title">${statusPopupLabel}</h2><button type="button" class="secondary" popovertarget="pass-status-${j.id}" popovertargetaction="hide" autofocus>닫기</button></div><p>${j.status eq 'ARCHIVED' ? '제작 확정 목록으로 이동합니다. 저장한 여행 기록은 유지됩니다.' : '여행을 마쳤다면 사용 완료로 보관하세요. 구성을 바꾸려면 제작 중으로 되돌릴 수 있습니다. 저장한 여행 기록은 유지됩니다.'}</p><form method="post" action="${root}/journeys/save"><%@ include file="csrf.jspf" %><input type="hidden" name="id" value="${j.id}"><button name="status" value="${j.status eq 'ARCHIVED' ? 'CONFIRMED' : 'ARCHIVED'}">${statusActionLabel}</button><c:if test="${j.status eq 'CONFIRMED'}"><button class="secondary" name="status" value="PLANNING">제작 중으로 보내기</button></c:if></form></section>
</c:if></div></article></c:forEach></div>
<c:if test="${journeyStatus eq 'CONFIRMED'}"><p><a href="${root}/passes">시연 혜택 발급·이용권 관리</a></p></c:if>
<c:if test="${journeyStatus eq 'ARCHIVED'}"><p><a href="${root}/feedback/history">가맹점 혜택 사용 기록·평가</a></p></c:if>
</c:when><c:otherwise>
<article class="pass-card journey-business-card ${not empty data.coverImage ? 'has-cover' : ''}"><c:set var="cover" value="${data}"/><%@ include file="journey-cover.jspf" %><div class="pass-card-main"><span class="journey-ticket-status"><c:out value="${data.statusLabel}"/></span><h1><c:out value="${data.name}"/></h1><p><c:out value="${empty data.travelDate ? '날짜 미정' : data.travelDate}"/> · ${fn:length(data.places)}장</p><%@ include file="journey-cover-credit.jspf" %></div></article>
<details><summary>이름·날짜·혜택 이용권 설정</summary><form method="post" action="${root}/journeys/save"><%@ include file="csrf.jspf" %><input type="hidden" name="id" value="${data.id}">
<label>패스 이름<input name="name" maxlength="100" required value="${fn:escapeXml(data.name)}"></label><label>여행 날짜<input type="date" name="travelDate" value="${fn:escapeXml(data.travelDate)}"></label>
<label>선택 혜택 이용권<select name="issuedPassId"><option value="">연결 안 함</option><c:forEach var="p" items="${benefitPasses}"><option value="${p.id}" ${data.issuedPassId eq p.id ? 'selected' : ''}><c:out value="${p.productName}"/> #${p.id} · <c:out value="${p.statusLabel}"/></option></c:forEach></select></label><button>설정 저장</button></form></details>
<c:if test="${data.status eq 'ARCHIVED'}"><p><a class="button" href="${root}/journeys/photocards?id=${data.id}">포토카드 보기</a></p><p>보관된 여행입니다. 기록은 계속 수정할 수 있습니다. 복원하면 제작 확정 목록으로 이동합니다.</p></c:if>
<c:if test="${empty data.places}"><p class="empty-state">저장된 장소가 없습니다.</p></c:if>
<p>장소 정보는 담을 당시 기준입니다. 방문 날짜와 만족도는 본인 기록이며 방문 인증이 아닙니다.</p>
<c:if test="${not empty data.places}"><section class="journey-records" aria-label="여행 카드별 기록"><div class="record-navigation" hidden><button type="button" id="record-previous" class="secondary" aria-label="이전 기록 카드">←</button><span id="record-position" role="status" aria-live="polite"></span><button type="button" id="record-next" class="secondary" aria-label="다음 기록 카드">→</button></div><div class="record-cards" tabindex="0" role="region" aria-label="좌우로 넘겨 여행 기록 작성"><c:forEach var="p" items="${data.places}" varStatus="order"><article class="journey-record-card destination-card" id="record-${p.id}"><h2>${order.count}. <c:out value="${p.placeName}"/></h2><p>${p.cardKind eq 'EVENT' ? '행사' : p.cardKind eq 'MERCHANT' ? '가맹점' : p.cardKind eq 'DINING' ? '음식점·카페' : '관광지'}</p><p><c:out value="${p.regionName}"/> · <c:out value="${p.locationDescription}"/> · <c:out value="${p.materialKind eq 'REAL' ? '실제 관광 소개' : '시연 자료'}"/></p>
<p><c:out value="${empty p.visitedOn ? '방문 전' : '다녀옴 · 본인 기록'}"/> <c:out value="${p.visitedOn}"/></p>

<form method="post" action="${root}/journeys/record"><div class="record-fields"><%@ include file="csrf.jspf" %><input type="hidden" name="id" value="${data.id}"><input type="hidden" name="itemId" value="${p.id}"><label>방문 날짜<input type="date" name="visitedOn" aria-describedby="record-hint-${p.id}" value="${fn:escapeXml(p.visitedOn)}"></label><label>만족도<select name="rating" aria-describedby="record-hint-${p.id}"><option value="">선택 안 함</option><c:forEach var="score" begin="1" end="5"><option value="${score}" ${p.rating eq score ? 'selected' : ''}>${score}점</option></c:forEach></select></label></div><p class="form-hint" id="record-hint-${p.id}">날짜를 비우면 방문 전으로 표시해요. 만족도는 방문 후 선택해 주세요.</p><label>나만의 메모<textarea name="note" maxlength="500" rows="3" placeholder="기억에 남는 경험이나 다음에 다시 해보고 싶은 일을 남겨 보세요."><c:out value="${p.note}"/></textarea></label><button>기록 저장</button></form>
<section class="record-photo"><h3>내가 찍은 사진</h3><c:if test="${p.hasPhoto}"><img src="${root}/journeys/photo?id=${data.id}&amp;itemId=${p.id}" alt="${fn:escapeXml(p.placeName)}에서 찍은 사진" loading="lazy"></c:if>
<form method="post" enctype="multipart/form-data" action="${root}/journeys/photo"><%@ include file="csrf.jspf" %><input type="hidden" name="id" value="${data.id}"><input type="hidden" name="itemId" value="${p.id}"><label>사진 ${p.hasPhoto ? '교체' : '선택'}<input type="file" name="photo" accept="image/jpeg,image/png" required aria-describedby="photo-help-${p.id}"></label><p class="form-hint" id="photo-help-${p.id}">직접 촬영한 JPEG·PNG, 8MB·1,600만 화소 이하. 본인만 볼 수 있으며 사용 완료 후 포토카드로 출력할 수 있어요.</p><button>${p.hasPhoto ? '사진 교체' : '사진 저장'}</button></form>
<c:if test="${p.hasPhoto}"><form method="post" action="${root}/journeys/photo"><%@ include file="csrf.jspf" %><input type="hidden" name="id" value="${data.id}"><input type="hidden" name="itemId" value="${p.id}"><button class="secondary" name="intent" value="delete">사진 삭제</button></form></c:if></section></article></c:forEach>
</div></section><script src="${root}/assets/card-scroll.js" defer></script><script src="${root}/assets/journey-records.js" defer></script></c:if>
<h2>선택 혜택 이용권</h2><p>여행 패스에 장소를 담아도 혜택이 발급되거나 사용되지는 않습니다. 이용권의 24시간 유효기간은 여행 기록과 별개입니다.</p>
<c:choose><c:when test="${not empty data.benefitPass}"><p><a href="${root}/passes/detail?id=${data.issuedPassId}"><c:out value="${data.benefitPass.productName}"/></a> · <c:out value="${data.benefitPass.statusLabel}"/></p><a href="${root}/feedback/history">확인된 혜택 사용 이력·피드백</a></c:when><c:otherwise><p>연결된 이용권이 없습니다. <a href="${root}/merchants">혜택 살펴보기</a> · <a href="${root}/passes">내 혜택 이용권</a></p></c:otherwise></c:choose>
<details><summary>이용권 연결 이력</summary>
<c:if test="${empty data.benefitPassHistory}"><p>아직 연결 이력이 없습니다.</p></c:if>
<c:forEach var="link" items="${data.benefitPassHistory}"><article class="pass-card"><div class="pass-card-main"><h4><a href="${root}/passes/detail?id=${link.issuedPassId}"><c:out value="${link.productName}"/> #<c:out value="${link.issuedPassId}"/></a></h4><p><c:out value="${link.statusLabel}"/></p><p>연결: <c:out value="${empty link.linkedAt ? '미확인' : link.linkedAtKst}"/> · <c:out value="${empty link.disconnectedAt ? '현재 연결 중' : '해제:'}"/> <c:out value="${link.disconnectedAtKst}"/></p></div><div class="pass-card-action"><span>연결 이력</span></div></article></c:forEach>
</details></c:otherwise></c:choose>
