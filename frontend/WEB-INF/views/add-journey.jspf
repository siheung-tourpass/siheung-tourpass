<%@ page pageEncoding="UTF-8" %>
<c:choose><c:when test="${user.role eq 'VISITOR' and not empty journeys}"><form method="post" action="${root}/journeys/add"><input type="hidden" name="csrf" value="${fn:escapeXml(csrf)}"><input type="hidden" name="placeId" value="${addPlaceId}"><label>담을 여행 패스<select name="id"><c:forEach var="j" items="${journeys}"><option value="${j.id}"><c:out value="${j.name}"/></option></c:forEach></select></label><button>내 여행에 담기</button></form></c:when><c:when test="${user.role eq 'VISITOR'}"><a href="${root}/journeys">여행 패스를 먼저 만들어 주세요</a></c:when><c:when test="${empty user}"><a href="${root}/login">로그인하고 내 여행에 담기</a></c:when></c:choose>
