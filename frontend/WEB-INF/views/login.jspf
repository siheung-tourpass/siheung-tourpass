<%@ page pageEncoding="UTF-8" %>
<section class="panel login-panel"><h1>로그인</h1><p>계정으로 로그인해 이어서 이용하세요.</p><c:if test="${not empty message}"><p class="error" role="alert"><c:out value="${message}"/></p></c:if><form method="post" action="${root}/login"><%@ include file="csrf.jspf" %><label>아이디<input name="loginId" maxlength="100" autocomplete="username" required></label><label>비밀번호<input type="password" name="password" maxlength="500" autocomplete="current-password" required></label><button>로그인</button></form><p class="login-alternative">먼저 둘러보고 싶다면 <a href="${root}/explore">여행 카드 둘러보기 →</a></p></section>
