<%@ page pageEncoding="UTF-8" %>
<h1>어떤 여행을 좋아하세요?</h1><p>관광 추천 · 원하는 조건을 고르면, 어울리는 장소를 최대 3곳 추천해 드려요.</p><form class="recommendation-form" method="get" action="${root}/recommendations"><label>희망 지역<select name="regionId"><option value="">시흥시 전체</option><c:forEach var="item" items="${options.regions}"><option value="${item.id}" ${param.regionId eq item.id ? 'selected' : ''}><c:out value="${item.name}"/></option></c:forEach></select></label>

<label>동반 유형<select name="companionId"><option value="">선택 안 함</option><c:forEach var="item" items="${options.companionTypes}"><option value="${item.id}" ${param.companionId eq item.id ? 'selected' : ''}><c:out value="${item.name}"/></option></c:forEach></select></label><fieldset><legend>관심 테마 · 복수 선택 가능</legend><c:forEach var="item" items="${options.themes}"><c:set var="selectedTheme" value="false"/><c:forEach var="selectedId" items="${paramValues.themeId}"><c:if test="${selectedId eq item.id}"><c:set var="selectedTheme" value="true"/></c:if></c:forEach><label><input type="checkbox" name="themeId" value="${item.id}" ${selectedTheme ? 'checked' : ''}> <c:out value="${item.name}"/></label></c:forEach></fieldset><div class="form-action"><button>추천 보기</button></div></form>
<p><c:out value="${data.notice}"/></p><c:if test="${empty data.items}"><p class="empty-state">조건에 맞는 장소가 없습니다. 지역·테마·동반 유형을 변경해 주세요.</p></c:if>
<c:forEach var="item" items="${data.items}"><article><h2><a href="${root}/places/detail?id=${item.place.id}"><c:out value="${item.place.name}"/></a></h2><p><c:out value="${item.place.region.name}"/> · <c:out value="${item.place.locationDescription}"/></p><p><c:out value="${item.place.materialKind eq 'REAL' ? '실제 관광 소개' : '시연 자료·실제 사용 불가'}"/> · <c:out value="${item.place.reviewStatusLabel}"/></p><p><c:out value="${item.place.description}"/></p><p class="result-reason">추천 이유: <c:out value="${item.explanation}"/></p><p class="result-score">기본 <c:out value="${item.score.base}"/> + 본인 평가 <c:out value="${item.score.personal}"/> = <c:out value="${item.score.total}"/> · 반영 평가 <c:out value="${item.score.feedbackCount}"/>건</p>
<p><c:out value="${empty item.passBenefits ? '시연 패스 혜택 연결 없음' : '시연 패스에 포함·실제 사용 불가'}"/></p><c:forEach var="availability" items="${item.myPassAvailability}"><p><a href="${root}/passes/detail?id=${availability.passId}">내 혜택 이용권</a> · <c:out value="${availability.reasonLabel}"/> · 확인 <c:out value="${availability.checkedAtKst}"/></p></c:forEach><c:set var="addPlaceId" value="${item.place.id}"/><%@ include file="add-journey.jspf" %></article></c:forEach>
