<%@ page pageEncoding="UTF-8" %>
<h1>어떤 여행을 좋아하세요?</h1><p>관광 추천 · 원하는 조건을 고르면, 어울리는 장소를 최대 3곳 추천해 드려요.</p><form class="recommendation-form" method="get" action="${root}/recommendations"><label>희망 지역<select name="regionId"><option value="">시흥시 전체</option><c:forEach var="item" items="${options.regions}"><option value="${item.id}" ${param.regionId eq item.id ? 'selected' : ''}><c:out value="${item.name}"/></option></c:forEach></select></label>

<label>동반 유형<select name="companionId"><option value="">선택 안 함</option><c:forEach var="item" items="${options.companionTypes}"><option value="${item.id}" ${param.companionId eq item.id ? 'selected' : ''}><c:out value="${item.name}"/></option></c:forEach></select></label><fieldset><legend>관심 테마 · 복수 선택 가능</legend><c:forEach var="item" items="${options.themes}"><c:set var="selectedTheme" value="false"/><c:forEach var="selectedId" items="${paramValues.themeId}"><c:if test="${selectedId eq item.id}"><c:set var="selectedTheme" value="true"/></c:if></c:forEach><label><input type="checkbox" name="themeId" value="${item.id}" ${selectedTheme ? 'checked' : ''}> <c:out value="${item.name}"/></label></c:forEach></fieldset><div class="form-action"><p class="form-hint">선택하지 않아도 추천받을 수 있어요.</p><a class="button secondary" href="${root}/recommendations">조건 초기화</a><button>추천 보기</button></div></form>
<section class="results" aria-labelledby="results-title"><div class="section-heading"><h2 id="results-title">추천 장소 <span class="count">${fn:length(data.items)}곳</span></h2><a href="#main">조건 다시 고르기 ↑</a></div><p class="result-meta"><c:out value="${data.notice}"/></p><c:if test="${empty data.items}"><div class="empty-state"><h3>조건에 맞는 장소가 없습니다</h3><p>선택한 지역에 공개된 장소가 없을 수 있어요. 지역을 바꾸거나 조건을 초기화해 보세요.</p><a class="button secondary" href="${root}/recommendations">조건 초기화</a></div></c:if>
<c:forEach var="item" items="${data.items}"><article class="recommendation-card"><div class="recommendation-media"><c:set var="imagePlace" value="${item.place}"/><%@ include file="place-image.jspf" %></div><div class="recommendation-content"><h3><a href="${root}/places/detail?id=${item.place.id}"><c:out value="${item.place.name}"/></a></h3><p><c:out value="${item.place.region.name}"/> · <c:out value="${item.place.locationDescription}"/></p><p><c:out value="${item.place.materialKind eq 'REAL' ? '실제 관광 소개' : '시연 자료·실제 사용 불가'}"/> · <c:out value="${item.place.reviewStatusLabel}"/></p><p><c:out value="${item.place.description}"/></p><p class="result-reason">추천 이유: <c:out value="${item.explanation}"/></p><details class="recommendation-details"><summary>추천 점수·혜택 확인</summary><p class="result-score">기본 <c:out value="${item.score.base}"/> + 본인 평가 <c:out value="${item.score.personal}"/> = <c:out value="${item.score.total}"/> · 반영 평가 <c:out value="${item.score.feedbackCount}"/>건</p>
<p><c:out value="${empty item.passBenefits ? '시연 패스 혜택 연결 없음' : '시연 패스에 포함·실제 사용 불가'}"/></p><c:forEach var="availability" items="${item.myPassAvailability}"><p><a href="${root}/passes/detail?id=${availability.passId}">내 혜택 이용권</a> · <c:out value="${availability.reasonLabel}"/> · 확인 <c:out value="${availability.checkedAtKst}"/></p></c:forEach></details><a class="detail-link" href="${root}/places/detail?id=${item.place.id}">장소 자세히 보기 →</a><c:set var="addPlaceId" value="${item.place.id}"/><%@ include file="add-journey.jspf" %></div></article></c:forEach></section>
