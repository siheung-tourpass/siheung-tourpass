<%@ page pageEncoding="UTF-8" %>
<c:choose><c:when test="${view eq 'passes'}"><h1><c:out value="${user.role eq 'ADMIN' ? '패스 관리' : '내 혜택 이용권'}"/></h1><c:if test="${empty data}"><p>발급 기록이 없습니다.</p><a href="${root}/merchants">상품 보기</a></c:if><c:forEach var="item" items="${data}"><article><h2><a href="${root}${user.role eq 'ADMIN' ? '/admin' : ''}/passes/detail?id=${item.id}"><c:out value="${item.productName}"/></a></h2><p><c:out value="${item.statusLabel}"/> · 발급 <c:out value="${item.startsAtKst}"/> · 만료 <c:out value="${item.expiresAtKst}"/></p><p>시연용·실제 사용 불가</p></article></c:forEach></c:when>
<c:otherwise><h1><c:out value="${data.productName}"/></h1><p>상태: <c:out value="${data.statusLabel}"/></p><dl><dt>시작</dt><dd><c:out value="${data.startsAtKst}"/></dd><dt>만료</dt><dd><c:out value="${data.expiresAtKst}"/> · 만료 정각부터 사용 불가</dd><c:if test="${not empty data.cancelledAt}"><dt>취소</dt><dd><c:out value="${data.cancelledAtKst}"/> · <c:out value="${data.cancelReason}"/></dd></c:if></dl>
<c:if test="${user.role eq 'VISITOR'}"><h2>가맹점에 제시할 코드</h2><p class="code"><c:out value="${data.code}"/></p><p>담당자가 코드를 조회하고 배정 혜택을 확인하면 사용이 완료됩니다.</p><a href="${root}/feedback/history">사용 이력·피드백 보기</a></c:if>
<c:if test="${user.role eq 'ADMIN' and data.status ne 'EXPIRED' and data.status ne 'CANCELLED'}"><form method="post" action="${root}/admin/passes/cancel"><input type="hidden" name="csrf" value="${fn:escapeXml(csrf)}"><input type="hidden" name="id" value="${data.id}"><label>취소 사유<textarea name="reason" maxlength="500" required></textarea></label><button>패스 취소</button></form></c:if>
<c:set var="benefits" value="${data.benefits}"/><%@ include file="benefits.jspf" %></c:otherwise></c:choose>
