<%@ page pageEncoding="UTF-8" %>
<c:if test="${user.role eq 'ADMIN'}"><%@ include file="admin-nav.jspf" %></c:if>
<c:choose><c:when test="${view eq 'passes'}"><h1><c:out value="${user.role eq 'ADMIN' ? '이용권 관리' : '내 혜택 이용권'}"/></h1><c:if test="${empty data}"><div class="empty-state"><h2>아직 발급한 이용권이 없어요</h2><p>상품의 혜택과 이용 조건을 확인한 뒤 발급하세요.</p><a class="button" href="${root}/merchants">혜택 상품 보기</a></div></c:if><c:forEach var="item" items="${data}"><article class="pass-card"><div class="pass-card-main"><h2><a href="${root}${user.role eq 'ADMIN' ? '/admin' : ''}/passes/detail?id=${item.id}"><c:out value="${item.productName}"/></a></h2><p>발급 <c:out value="${item.startsAtKst}"/> · 만료 <c:out value="${item.expiresAtKst}"/></p></div><div class="pass-card-action"><span class="journey-ticket-status"><c:out value="${item.statusLabel}"/></span><a class="button secondary" href="${root}${user.role eq 'ADMIN' ? '/admin' : ''}/passes/detail?id=${item.id}">이용권 보기</a></div></article></c:forEach></c:when>
<c:otherwise><article class="pass-card"><div class="pass-card-main"><h1><c:out value="${data.productName}"/></h1><p>상태: <c:out value="${data.statusLabel}"/></p><dl><dt>시작</dt><dd><c:out value="${data.startsAtKst}"/></dd><dt>만료</dt><dd><c:out value="${data.expiresAtKst}"/> · 만료 정각부터 사용 불가</dd><c:if test="${not empty data.cancelledAt}"><dt>취소</dt><dd><c:out value="${data.cancelledAtKst}"/> · <c:out value="${data.cancelReason}"/></dd></c:if></dl></div><div class="pass-card-action"><span class="journey-ticket-status"><c:out value="${data.statusLabel}"/></span></div></article>
<c:if test="${user.role eq 'VISITOR'}"><h2>가맹점에 제시할 코드</h2><p class="code"><c:out value="${data.code}"/></p><p>담당자에게 코드를 보여 주세요. 혜택을 확인하고 사용 처리하면 1회 차감됩니다.</p><a href="${root}/feedback/history">사용 이력·피드백 보기</a></c:if>
<c:if test="${user.role eq 'ADMIN' and data.status ne 'EXPIRED' and data.status ne 'CANCELLED'}"><form method="post" action="${root}/admin/passes/cancel"><%@ include file="csrf.jspf" %><input type="hidden" name="id" value="${data.id}"><label>취소 사유<textarea name="reason" maxlength="500" required></textarea></label><button>이용권 취소</button></form></c:if>
<c:set var="benefits" value="${data.benefits}"/><%@ include file="benefits.jspf" %></c:otherwise></c:choose>
