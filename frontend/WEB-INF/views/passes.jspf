<%@ page pageEncoding="UTF-8" %>
<c:if test="${user.role eq 'ADMIN'}"><%@ include file="admin-nav.jspf" %></c:if>
<c:choose><c:when test="${view eq 'passes' and user.role eq 'VISITOR'}"><h1>내 투어패스</h1>
<section class="panel mypass" aria-labelledby="mypass-active-title"><h2 id="mypass-active-title">사용 중인 이용권</h2>
<c:choose><c:when test="${not empty activeBenefitPass}"><p class="mypass-name"><c:out value="${activeBenefitPass.productName}"/> <span class="journey-ticket-status"><c:out value="${activeBenefitPass.statusLabel}"/></span></p><p class="mypass-remaining"><span>남은 시간</span><strong><c:out value="${activeBenefitPassRemaining}"/></strong></p>
<p class="mypass-code-label">가맹점에 제시할 코드</p><p class="code"><c:out value="${activeBenefitPass.code}"/></p><p>담당자가 혜택을 확인하고 사용 처리하면 1회 차감돼요. 만료 <c:out value="${activeBenefitPass.expiresAtKst}"/> · 만료 정각부터 사용 불가</p>
<details><summary>혜택별 남은 횟수</summary><ul class="guide-benefit-list"><c:forEach var="benefit" items="${activeBenefitPass.benefits}"><li><strong><c:out value="${benefit.merchantName}"/></strong> <c:out value="${benefit.benefitName}"/> · 잔여 <c:out value="${benefit.remainingCount}"/>회 · <c:out value="${benefit.reasonLabel}"/></li></c:forEach></ul></details></c:when>
<c:otherwise><p>지금 사용할 수 있는 이용권이 없어요. 위쪽 전체 상품에서 혜택을 확인하고 이용할 때 발급하세요.</p><a class="button" href="${root}/merchants">전체 상품 보기</a></c:otherwise></c:choose></section>
<section class="guide-section" aria-labelledby="mypass-history-title"><h2 id="mypass-history-title">혜택 사용 이력</h2>
<c:if test="${empty benefitHistory}"><p>아직 사용한 혜택이 없어요.</p></c:if>
<c:forEach var="item" items="${benefitHistory}"><article class="pass-card"><div class="pass-card-main"><h3><c:out value="${item.benefitName}"/></h3><p><c:out value="${item.merchantName}"/> · <c:out value="${item.usedAtKst}"/></p></div><div class="pass-card-action"><a class="button secondary" href="${root}/feedback/edit?id=${item.id}">피드백</a></div></article></c:forEach></section>
<c:if test="${not empty data}"><section class="guide-section" aria-labelledby="mypass-all-title"><h2 id="mypass-all-title">발급한 이용권</h2>
<c:forEach var="item" items="${data}"><a class="pass-row" href="${root}/passes/detail?id=${item.id}"><span><strong><c:out value="${item.productName}"/></strong><small>발급 <c:out value="${item.startsAtKst}"/> · 만료 <c:out value="${item.expiresAtKst}"/></small></span><span class="journey-ticket-status"><c:out value="${item.statusLabel}"/></span></a></c:forEach></section></c:if></c:when>
<c:when test="${view eq 'passes'}"><h1><c:out value="${user.role eq 'ADMIN' ? '이용권 관리' : '내 혜택 이용권'}"/></h1><c:if test="${empty data}"><div class="empty-state"><h2>아직 발급한 이용권이 없어요</h2><p>상품의 혜택과 이용 조건을 확인한 뒤 발급하세요.</p><a class="button" href="${root}/merchants">혜택 상품 보기</a></div></c:if><c:forEach var="item" items="${data}"><article class="pass-card"><div class="pass-card-main"><h2><a href="${root}${user.role eq 'ADMIN' ? '/admin' : ''}/passes/detail?id=${item.id}"><c:out value="${item.productName}"/></a></h2><p>발급 <c:out value="${item.startsAtKst}"/> · 만료 <c:out value="${item.expiresAtKst}"/></p></div><div class="pass-card-action"><span class="journey-ticket-status"><c:out value="${item.statusLabel}"/></span><a class="button secondary" href="${root}${user.role eq 'ADMIN' ? '/admin' : ''}/passes/detail?id=${item.id}">이용권 보기</a></div></article></c:forEach></c:when>
<c:otherwise><article class="pass-card"><div class="pass-card-main"><h1><c:out value="${data.productName}"/></h1><p>상태: <c:out value="${data.statusLabel}"/></p><dl><dt>시작</dt><dd><c:out value="${data.startsAtKst}"/></dd><dt>만료</dt><dd><c:out value="${data.expiresAtKst}"/> · 만료 정각부터 사용 불가</dd><c:if test="${not empty data.cancelledAt}"><dt>취소</dt><dd><c:out value="${data.cancelledAtKst}"/> · <c:out value="${data.cancelReason}"/></dd></c:if></dl></div><div class="pass-card-action"><span class="journey-ticket-status"><c:out value="${data.statusLabel}"/></span></div></article>
<c:if test="${user.role eq 'VISITOR'}"><h2>가맹점에 제시할 코드</h2><p class="code"><c:out value="${data.code}"/></p><p>담당자에게 코드를 보여 주세요. 혜택을 확인하고 사용 처리하면 1회 차감됩니다.</p></c:if>
<c:if test="${user.role eq 'ADMIN' and data.status ne 'EXPIRED' and data.status ne 'CANCELLED'}"><form method="post" action="${root}/admin/passes/cancel"><%@ include file="csrf.jspf" %><input type="hidden" name="id" value="${data.id}"><label>취소 사유<textarea name="reason" maxlength="500" required></textarea></label><button>이용권 취소</button></form></c:if>
<c:set var="benefits" value="${data.benefits}"/><%@ include file="benefits.jspf" %></c:otherwise></c:choose>
